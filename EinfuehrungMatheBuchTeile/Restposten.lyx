\begin_layout Standard
Zu Deiner Erinnerung an den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:Negation-Konjunktion"
nolink "false"

\end_inset

:
 Es seien 
\begin_inset Formula $A,B$
\end_inset

 Metasymbole von Symbolen,
 welche in sich,
 jedoch auch bezüglich den anderen Aussagen des Satzes widerspruchsfrei seien.
 Dann gilt
\begin_inset Formula 
\[
\left(\neg\left(A\wedge B\right)\right)\Leftrightarrow\left(\left(\neg A\right)\vee\left(\neg B\right)\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Es seien 
\begin_inset Formula $A,B\in\delta$
\end_inset

.
 Dann gilt gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Aequivalenz"
nolink "false"

\end_inset

:
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\neg\left(A\wedge B\right)\right)\Leftrightarrow\left(\left(\neg A\right)\vee\left(\neg B\right)\right)\right)\\
= & 1-\left(\delta\left(\neg\left(A\wedge B\right)\right)-\delta\left(\left(\neg A\right)\vee\left(\neg B\right)\right)\right)^{2}
\end{align*}

\end_inset

Ich möchte den Minuenden den 
\begin_inset Formula $\delta\left(\neg\left(A\wedge B\right)\right)$
\end_inset

 sowie den Subtrahenden 
\begin_inset Formula $\delta\left(\left(\neg A\right)\vee\left(\neg B\right)\right)$
\end_inset

 separat berechnen.
 Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 gilt:
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{equation}
\delta\left(\neg\left(A\wedge B\right)\right)=1-\delta\left(A\wedge B\right)\label{eq:Negation-Konjunktion-erste-Gleichung}
\end{equation}

\end_inset

Aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Konjunktion"
nolink "false"

\end_inset

 kann ich schreiben:
\begin_inset Formula 
\[
\delta\left(A\wedge B\right)=\delta\left(A\right)\cdot\delta\left(B\right)
\]

\end_inset

Setze ich dies in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Negation-Konjunktion-erste-Gleichung"
nolink "false"

\end_inset

 ein,
 dann erhalte ich:
\end_layout

\begin_layout Proof
\begin_inset Formula 
\[
\delta\left(\neg\left(A\wedge B\right)\right)=1-\delta\left(A\right)\cdot\delta\left(B\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Die Umrechnung des Ausdrucks 
\begin_inset Formula 
\[
\delta\left(\left(\neg A\right)\vee\left(\neg B\right)\right)
\]

\end_inset

ist dagegen mühsamer.
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\neg A\right)\vee\left(\neg B\right)\right)\\
= & \delta\left(\neg A\right)+\delta\left(\neg B\right)-\delta\left(\neg A\right)\cdot\delta\left(\neg B\right)\\
= & 1-\delta\left(A\right)+1-\delta\left(B\right)-\left(1-\delta\left(A\right)\right)\cdot\left(1-\delta\left(B\right)\right)\\
= & 2-\delta\left(A\right)-\delta\left(B\right)-\\
 & \left(1\cdot\left(1-\delta\left(B\right)\right)-\delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)\right)\\
= & 2-\delta\left(A\right)-\delta\left(B\right)-\\
 & \left(1-\delta\left(B\right)-\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 2-\delta\left(A\right)-\delta\left(B\right)+\\
 & \left(-1\right)+\delta\left(B\right)+\delta\left(A\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
= & 2-1+\delta\left(A\right)-\delta\left(A\right)+\delta\left(B\right)-\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & 1+0+0-\delta\left(A\right)\cdot\delta\left(B\right)\\
= & 1-\delta\left(A\right)\cdot\delta\left(B\right)
\end{align*}

\end_inset

Darum behaupte ich,
 schließen zu können:
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\neg\left(A\wedge B\right)\right)\Leftrightarrow\left(\left(\neg A\right)\vee\left(\neg B\right)\right)\right)\\
= & 1-\left(\delta\left(\neg\left(A\wedge B\right)\right)-\delta\left(\left(\neg A\right)\vee\left(\neg B\right)\right)\right)^{2}\\
= & 1-\left(\left(1-\delta\left(A\right)\cdot\delta\left(B\right)\right)-\left(1-\delta\left(A\right)\cdot\delta\left(B\right)\right)\right)\\
= & 1-\left(1-\delta\left(A\right)\cdot\delta\left(B\right)-1+\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 1-\left(1-1+\delta\left(A\right)\cdot\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 1-\left(0+0\right)\\
= & 1-0\\
= & 1
\end{align*}

\end_inset

Da nun gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Eindeutigkeitssatz"
nolink "false"

\end_inset

 gelten muss,
 dass die Aussage 
\begin_inset Formula 
\[
\left(\neg\left(A\wedge B\right)\right)\Leftrightarrow\left(\left(\neg A\right)\vee\left(\neg B\right)\right)
\]

\end_inset


\end_layout

\begin_layout Proof
für alle möglichen Aussagen 
\begin_inset Formula $A$
\end_inset

 und 
\begin_inset Formula $B$
\end_inset

 wahr und somit somit ein logischer Satz sein muss,
 erachte ich den Beweis hiermit als erbracht.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Konjunktive Normalform der Implikation
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Unter dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:konjunktive-Normalform-Implikation"
nolink "false"

\end_inset

 versuchte ich,
 zu zeigen,
 wieso gelten muss (falls 
\begin_inset Formula $A$
\end_inset

 und 
\begin_inset Formula $B$
\end_inset

 Metasymbole für Aussagen seien,
 welche widerspruchsfrei seien)
\begin_inset Formula 
\[
\left(A\Rightarrow B\right)\Leftrightarrow\left(\neg A\vee B\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Gemäß der Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:delta-Notation-Implikation"
nolink "false"

\end_inset

 gilt:
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{align*}
 & \delta\left(\neg A\vee B\right)\\
= & \delta\left(\neg A\right)+\delta\left(B\right)-\delta\left(\neg A\right)\cdot\delta\left(B\right)\\
= & 1-\delta\left(A\right)+\delta\left(B\right)-\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\\
= & 1-\delta\left(A\right)+\delta\left(B\right)-\left(\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 1-\delta\left(A\right)+\delta\left(B\right)-\delta\left(B\right)+\delta\left(A\right)\cdot\delta\left(B\right)\\
= & 1-\delta\left(A\right)+0+\delta\left(A\right)\cdot\delta\left(B\right)\\
= & 1-\left(\delta\left(A\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 1-\left(\delta\left(A\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 1-\delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)\\
= & \delta\left(A\Rightarrow B\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Satz der Negation der Disjunktion
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Sind 
\begin_inset Formula $A$
\end_inset

 sowie 
\begin_inset Formula $B$
\end_inset

 Metasymbole von Aussagen,
 welche in sich selbst sowie bezüglich den anderen Symbolen des Satzes widerspruchsfrei sind,
 dann kann ich schreiben:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\neg\left(A\vee B\right)\Leftrightarrow\neg A\wedge\neg B
\]

\end_inset


\end_layout

\begin_layout Proof
(des Satzes der Negation der Disjunktion) Es seien 
\begin_inset Formula $A,B\in\delta$
\end_inset

.
 Dann ist gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Antivalenz"
nolink "false"

\end_inset

 der Deltanotation der Äquivalenz
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\neg\left(A\vee B\right)\right)\Leftrightarrow\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)\right)\\
= & 1-\left(\delta\left(\neg\left(A\vee B\right)\right)-\delta\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)\right)^{2}
\end{align*}

\end_inset

Wiederum möchte ich Minuend und Subtrahend der Differenz 
\begin_inset Formula 
\[
\delta\left(\neg\left(A\vee B\right)\right)-\delta\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)
\]

\end_inset

einzeln berechnen.
 Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 der Deltanotation der Negation kann ich schreiben 
\begin_inset Formula 
\begin{align*}
 & \delta\left(\neg\left(A\vee B\right)\right)\\
= & 1-\delta\left(A\vee B\right)\\
= & 1-\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 1-\delta\left(A\right)-\delta\left(B\right)+\delta\left(A\right)\cdot\delta\left(B\right)
\end{align*}

\end_inset

Nun kann ich gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Disjunktion"
nolink "false"

\end_inset

 der Deltanotation der Disjunktion kann ich schreiben:
\begin_inset Formula 
\[
\delta\left(A\vee B\right)=\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)
\]

\end_inset

Dieses Resultat kann ich in die Gleichung 
\begin_inset Formula 
\[
\delta\left(\neg\left(A\vee B\right)\right)=1-\delta\left(A\vee B\right)
\]

\end_inset

einfügen und erhalte 
\begin_inset Formula 
\begin{align*}
 & \delta\left(\neg\left(A\vee B\right)\right)\\
= & 1-\delta\left(A\vee B\right)\\
= & 1-\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 1-\delta\left(A\right)-\delta\left(B\right)+\delta\left(A\right)\cdot\delta\left(B\right)
\end{align*}

\end_inset

Andererseits gilt gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Konjunktion"
nolink "false"

\end_inset

 der Deltanotation der Konjunktion 
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)\\
= & \delta\left(\neg A\right)\cdot\delta\left(\neg B\right)
\end{align*}

\end_inset

Wiederum kann ich die Deltanotation der Aussagen 
\begin_inset Formula $\delta\left(\neg A\right)$
\end_inset

 sowie 
\begin_inset Formula $\delta\left(\neg B\right)$
\end_inset

 gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 umschreiben zu
\begin_inset Formula 
\begin{eqnarray*}
\delta\left(\neg A\right) & = & 1-\delta\left(A\right)\\
\delta\left(\neg B\right) & = & 1-\delta\left(B\right)
\end{eqnarray*}

\end_inset

Somit kann ich schreiben:
 
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)\\
= & \delta\left(\neg A\right)\cdot\delta\left(\neg B\right)\\
= & \left(1-\delta\left(A\right)\right)\cdot\left(1-\delta\left(B\right)\right)\\
= & 1\cdot\left(1-\delta\left(B\right)\right)+\left(-\delta\left(A\right)\right)\cdot\left(1-\delta\left(B\right)\right)\\
= & 1-\delta\left(B\right)-\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)
\end{align*}

\end_inset

Darum kann ich also schreiben
\begin_inset Formula 
\begin{align*}
 & \delta\left(\neg\left(A\vee B\right)\right)\\
= & 1-\delta\left(A\right)-\delta\left(B\right)+\delta\left(A\right)\cdot\delta\left(B\right)\\
= & \delta\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)
\end{align*}

\end_inset

und ebenso
\begin_inset Formula 
\begin{align*}
 & \delta\left(\neg\left(A\vee B\right)\right)-\delta\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)\\
= & 0
\end{align*}

\end_inset


\end_layout

\begin_layout Proof
Daraus kann ich schließen
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\neg\left(A\vee B\right)\right)\Leftrightarrow\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)\right)\\
= & 1-\left(\delta\left(\neg\left(A\vee B\right)\right)-\delta\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)\right)^{2}\\
= & 1-0^{2}\\
= & 1-0\\
= & 1
\end{align*}

\end_inset

Somit kann ich gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Eindeutigkeitssatz"
nolink "false"

\end_inset

 schließen,
 dass die Aussage
\begin_inset Formula 
\[
\left(\neg\left(A\vee B\right)\right)\Leftrightarrow\left(\left(\neg A\right)\wedge\left(\neg B\right)\right)
\]

\end_inset

für alle möglichen Aussagen 
\begin_inset Formula $A,B$
\end_inset

 wahr und somit ein logischer Satz ist.
 Damit habe ich jedoch den Beweis des Satzes der Negation der Disjunktion erbracht.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Satz des Ausschlusses
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Es seien 
\begin_inset Formula $A$
\end_inset

 sowie 
\begin_inset Formula $B$
\end_inset

 Metasymbole von Aussagen,
 welche in sich selbst und bezüglich den anderen Symbolen des Satzes widerspruchsfrei seien.
 Dann gilt:
\begin_inset Formula 
\[
\left(A\vee B\right)\wedge\neg A\Rightarrow B
\]

\end_inset


\end_layout

\begin_layout Proof
Es ist gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Implikation"
nolink "false"

\end_inset

 der Deltanotation der Implikation 
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\Rightarrow B\right)\\
= & 1-\delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\cdot\left(1-\delta\left(B\right)\right)
\end{align*}

\end_inset

Ich möchte jetzt zeigen,
 dass gilt:
\begin_inset Formula 
\[
\delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)=\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)
\]

\end_inset

Aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Konjunktion"
nolink "false"

\end_inset

 kann ich schreiben 
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\\
= & \delta\left(\left(A\vee B\right)\right)\cdot\delta\left(\neg A\right)
\end{align*}

\end_inset

Nun kann ich aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Disjunktion"
nolink "false"

\end_inset

 der Deltanotation der Disjunktion schreiben:
\begin_inset Formula 
\[
\delta\left(A\vee B\right)=\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)
\]

\end_inset

Dieses Resultat kann ich in die Gleichung
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\\
= & \delta\left(\left(A\vee B\right)\right)\cdot\delta\left(\neg A\right)
\end{align*}

\end_inset

einsetzen und erhalte:
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\\
= & \delta\left(\left(A\vee B\right)\right)\cdot\delta\left(\neg A\right)\\
= & \left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\cdot\left(1-\delta\left(A\right)\right)
\end{align*}

\end_inset

Nun kann ich gemäß aufgrund der Kommutativität der ganzzahligen Multiplikation schreiben:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\cdot\left(1-\delta\left(A\right)\right)\\
 & = & \left(1-\delta\left(A\right)\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)
\end{eqnarray*}

\end_inset

Jetzt kommt der mühsame Teil des Beweises.
 Ich muss den Ausdruck
\begin_inset Formula 
\[
\left(1-\delta\left(A\right)\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)
\]

\end_inset

ausrechnen.
 Es gilt aufgrund des Distributivgesetzes der ganzzahligen Multiplikation 
\begin_inset Formula 
\begin{align*}
 & \left(1-\delta\left(A\right)\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & \left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)+\\
 & \left(-\delta\left(A\right)\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)+\\
 & \left(-\delta^{2}\left(A\right)\right)-\delta\left(A\right)\cdot\delta\left(B\right)+\delta^{2}\left(A\right)\cdot\delta\left(B\right)
\end{align*}

\end_inset

Glücklicherweise ist die Deltanotation aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Idempotenz"
nolink "false"

\end_inset

.
 Also kann ich schreiben
\begin_inset Formula 
\[
\delta^{2}\left(A\right)=\delta\left(A\right)
\]

\end_inset

Dieses Resultat kann ich in die obige Rechnung einfügen und erhalte dann
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\\
= & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)+\\
 & \left(-\delta^{2}\left(A\right)\right)-\delta\left(A\right)\cdot\delta\left(B\right)+\delta^{2}\left(A\right)\cdot\delta\left(B\right)\\
= & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)+\\
 & \left(-\delta\left(A\right)\right)-\delta\left(A\right)\cdot\delta\left(B\right)+\delta\left(A\right)\cdot\delta\left(B\right)
\end{align*}

\end_inset

Jetzt kann ich,
 da die Addition von ganzen Zahlen kommutiert und assoziativ ist,
 schreiben
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\\
= & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)+\\
 & \left(-\delta\left(A\right)\right)-\delta\left(A\right)\cdot\delta\left(B\right)+\delta\left(A\right)\cdot\delta\left(B\right)\\
= & \delta\left(A\right)-\delta\left(A\right)+\delta\left(B\right)+\delta\left(A\right)\cdot\delta\left(B\right)-2\cdot\delta\left(A\right)\cdot\delta\left(B\right)\\
= & \delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)
\end{align*}

\end_inset

Ich kann 
\begin_inset Formula $\delta\left(B\right)$
\end_inset

 ausklammern und erhalte 
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\\
= & \delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
= & \delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)
\end{align*}

\end_inset

An dieser Stelle kann ich erneut von der Kommutation der Multiplikation Gebrauch machen und erhalte
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\\
= & \delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)\\
= & \left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)
\end{align*}

\end_inset

Somit gilt
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\Rightarrow B\right)\\
= & 1-\delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\cdot\left(1-\delta\left(B\right)\right)\\
= & 1-\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\cdot\left(1-\delta\left(B\right)\right)
\end{align*}

\end_inset

Infolge des Lemmas 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:Deltanotation-A-neg-A"
nolink "false"

\end_inset

 kann ich schreiben
\begin_inset Formula 
\[
\delta\left(B\right)\cdot\left(1-\delta\left(B\right)\right)=0
\]

\end_inset

Somit kann ich schreiben
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\Rightarrow B\right)\\
= & 1-\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\cdot\left(1-\delta\left(B\right)\right)\\
= & 1-\left(1-\delta\left(A\right)\right)\cdot0\\
= & 1-0\\
= & 1
\end{align*}

\end_inset

Somit kann ich gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Eindeutigkeitssatz"
nolink "false"

\end_inset

 
\end_layout

\begin_layout Proof
also schließen,
 dass diese Aussage ein logischer Satz ist.
\end_layout

\begin_layout Proof
Es gibt meines Erachtens noch eine interessante Abkürzung des Beweises.
 Und zwar geht diese so:
 Wenn ich zeigen kann,
 dass es ein geeignetes 
\begin_inset Formula $m$
\end_inset

 derart gibt,
 dass 
\begin_inset Formula $m$
\end_inset

 nur die Werte Null oder Eins annehmen kann,
 so dass ich schreiben kann 
\begin_inset Formula 
\[
\delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)=m\cdot\delta\left(B\right)
\]

\end_inset

dann bin ich bereits am Ziel:
 Denn in diesem in diesem Fall muss gelten
\begin_inset Formula 
\[
\delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)=m\cdot\delta\left(B\right)\leq\delta\left(B\right)
\]

\end_inset

Also kann ich in diesem Fall gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Implikation-kleiner-gleich"
nolink "false"

\end_inset

 schließen,
 dass in diesem Fall gelten muss
\begin_inset Formula 
\[
\left(A\vee B\right)\wedge\left(\neg A\right)\Rightarrow B
\]

\end_inset

sein muss.
 Das 
\begin_inset Formula $m$
\end_inset

 muss ich jedoch bestimmen.
 Dazu muss ich die Deltanotation von 
\begin_inset Formula 
\[
\left(A\vee B\right)\wedge\left(\neg A\right)
\]

\end_inset

umformen.
 Es ist gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Konjunktion"
nolink "false"

\end_inset

 der Deltanotion der Konjunktion
\begin_inset Formula 
\[
\delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)=\delta\left(A\vee B\right)\cdot\delta\left(\neg A\right)
\]

\end_inset

Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Konjunktion"
nolink "false"

\end_inset

 der Deltanotation der Disjunktion gilt
\begin_inset Formula 
\[
\delta\left(A\vee B\right)=\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)
\]

\end_inset

Weiter kann ich aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 der Deltanotation der Negation schreiben
\end_layout

\begin_layout Proof
\begin_inset Formula 
\[
\delta\left(\neg A\right)=1-\delta\left(A\right)
\]

\end_inset

Somit kann ich schreiben
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\\
 & = & \delta\left(A\vee B\right)\cdot\delta\left(\neg A\right)\\
 & = & \left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\cdot\left(1-\delta\left(A\right)\right)
\end{eqnarray*}

\end_inset

Nun ist die ganzzahlige Multiplikation kommutativ.
 Darum kann ich schreiben:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\left(A\vee B\right)\wedge\left(\neg A\right)\right)\\
 & = & \left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\cdot\left(1-\delta\left(A\right)\right)\\
 & = & \left(1-\delta\left(A\right)\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)
\end{eqnarray*}

\end_inset

Es bleibt mir trotzdem nichts anderes übrig,
 als das Produkt 
\begin_inset Formula 
\[
\left(1-\delta\left(A\right)\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)
\]

\end_inset

auszurechnen.
 Es gilt gemäß dem Distributivgesetz der Multiplikation und Addition der ganzen Zahlen:
 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \left(1-\delta\left(A\right)\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & 1\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)-\\
 &  & \left(\delta\left(A\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\right)\\
 & = & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)-\\
 &  & \left(\delta^{2}\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-\delta^{2}\left(A\right)\cdot\delta\left(B\right)\right)
\end{eqnarray*}

\end_inset

Da die Deltanotation,
 wie in Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Idempotenz"
nolink "false"

\end_inset

 zu zeigen versucht,
 idempotent ist,
 kann ich schreiben
\begin_inset Formula 
\[
\delta^{2}\left(A\right)=\delta\left(A\right)
\]

\end_inset

Somit kann ich schreiben und anschließend umformen:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \left(1-\delta\left(A\right)\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)-\\
 &  & \left(\delta^{2}\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-\delta^{2}\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)-\\
 &  & \left(\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)-\\
 &  & \left(\delta\left(A\right)+0\right)\\
 & = & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)-\\
 &  & \delta\left(A\right)\\
 & = & \delta\left(A\right)-\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & 0+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & \delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & \left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)
\end{eqnarray*}

\end_inset

Ich wende nun den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 sozusagen rückwärts an und erhalte
\begin_inset Formula 
\begin{eqnarray*}
 &  & \left(1-\delta\left(A\right)\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & \left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\\
 & = & \delta\left(\neg A\right)\cdot\delta\left(B\right)
\end{eqnarray*}

\end_inset

Nun kann ich das 
\begin_inset Formula $m$
\end_inset

 zu 
\begin_inset Formula $\delta\left(\neg A\right)$
\end_inset

 bestimmen.
 Es gilt also:
\begin_inset Formula 
\[
m=\delta\left(\neg A\right)
\]

\end_inset

Aufgrund der Eigenschaft der Deltanotation muss 
\begin_inset Formula $m$
\end_inset

 einen Wert in der Menge 
\begin_inset Formula $\left\{ 0,1\right\} $
\end_inset

 besitzen.
 Somit kann ich wirklich folgern,
 dass für alle möglichen und in sich widerspruchsfreien Aussagen 
\begin_inset Formula $A,B$
\end_inset

 gelten muss:
\begin_inset Formula 
\[
\left(A\vee B\right)\wedge\left(\neg A\right)\Rightarrow B
\]

\end_inset

und der Satz somit erneut bewiesen ist.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
Ob der zweite Beweis tatsächlich 
\begin_inset Quotes gld
\end_inset

eleganter
\begin_inset Quotes grd
\end_inset

 ist als der erste,
 muss ich natürlich Dir überlassen.
 Über Kunst lässt sich bekanntlich vortrefflich streiten.
 Aber ich für mich finde es interessant,
 dass ich mittels einer Ungleichung einen logischen Satz beweisen kann.
\end_layout

\begin_layout Section
Zusammenhang von Disjunktion und Konjunktion
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Es seien 
\begin_inset Formula $A$
\end_inset

 sowie 
\begin_inset Formula $B$
\end_inset

 Metasymbole von Aussagen.
 Dann gilt
\begin_inset Formula 
\[
\neg\left(\neg A\vee\neg B\right)\Leftrightarrow\left(A\wedge B\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Aequivalenz"
nolink "false"

\end_inset

 kann ich schreiben:
\begin_inset Formula 
\begin{align}
 & \delta\left(\neg\left(\neg A\vee\neg B\right)\Leftrightarrow\left(A\wedge B\right)\right)\nonumber \\
= & 1-\left(\delta\left(\neg\left(\neg A\vee\neg B\right)\right)-\delta\left(A\wedge B\right)\right)^{2}\label{eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-1}
\end{align}

\end_inset

Da gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Konjunktion"
nolink "false"

\end_inset

 gilt:
 
\begin_inset Formula $\delta\left(A\wedge B\right)=\delta\left(A\right)\cdot\delta\left(B\right)$
\end_inset

,
 bleibt mir übrig,
 den Ausdruck
\begin_inset Formula 
\[
\delta\left(\neg\left(\neg A\vee\neg B\right)\right)
\]

\end_inset

zu berechnen.
 Zuerst wandle ich mit Hilfe des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 der Deltanotation der Äquivalenz den Ausdruck um in
\begin_inset Formula 
\begin{align}
 & \delta\left(\neg\left(\neg A\vee\neg B\right)\right)\nonumber \\
= & 1-\delta\left(\neg A\vee\neg B\right)\label{eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-2}
\end{align}

\end_inset

Nun kann ich mittels dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Disjunktion"
nolink "false"

\end_inset

 der Deltanotation der Negation den Ausdruck 
\begin_inset Formula 
\[
\delta\left(\neg A\vee\neg B\right)
\]

\end_inset

 umrechnen zu
\begin_inset Formula 
\begin{equation}
\delta\left(\neg A\vee\neg B\right)=\delta\left(\neg A\right)+\delta\left(\neg B\right)-\delta\left(\neg A\right)\cdot\delta\left(\neg B\right)\label{eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-3}
\end{equation}

\end_inset

Es bleibt übrig,
 wiederum mittels dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 die Deltanotationen von 
\begin_inset Formula $\delta\left(\neg A\right)$
\end_inset

 sowie 
\begin_inset Formula $\delta\left(\neg B\right)$
\end_inset

 umzuschreiben in,
\begin_inset Formula 
\begin{eqnarray*}
\delta\left(\neg A\right) & = & 1-\delta\left(A\right)\\
\delta\left(\neg B\right) & = & 1-\delta\left(B\right)
\end{eqnarray*}

\end_inset

Ich füge diese Ergebnisse in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-3"
nolink "false"

\end_inset

 ein und erhalte
\begin_inset Formula 
\begin{eqnarray}
 &  & \delta\left(\neg A\vee\neg B\right)\nonumber \\
 & = & \delta\left(\neg A\right)+\delta\left(\neg B\right)-\delta\left(\neg A\right)\cdot\delta\left(\neg B\right)\nonumber \\
 & = & \left(1-\delta\left(A\right)\right)+\left(1-\delta\left(B\right)\right)-\left(1-\delta\left(A\right)\right)\cdot\left(1-\delta\left(B\right)\right)\nonumber \\
 & = & 2-\delta\left(A\right)-\delta\left(B\right)-\left(1-\delta\left(A\right)\right)\cdot\left(1-\delta\left(B\right)\right)\label{eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-4}
\end{eqnarray}

\end_inset

Ich möchte gerne den Term 
\begin_inset Formula 
\[
\left(1-\delta\left(A\right)\right)\cdot\left(1-\delta\left(B\right)\right)
\]

\end_inset

separat berechnen.
 Gemäß den Rechengesetzen der ganzen Zahlen kann ich schreiben:
 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \left(1-\delta\left(A\right)\right)\cdot\left(1-\delta\left(B\right)\right)\\
 & = & 1\cdot\left(1-\delta\left(B\right)\right)-\delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)\\
 & = & \left(1-\delta\left(B\right)\right)-\left(\delta\left(A\right)\cdot1-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & 1-\delta\left(B\right)-\left(\delta\left(A\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & 1-\delta\left(B\right)-\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)
\end{eqnarray*}

\end_inset

oder verkürzt geschrieben:
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{equation}
\left(1-\delta\left(A\right)\right)\cdot\left(1-\delta\left(B\right)\right)=1-\delta\left(B\right)-\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)\label{eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-5}
\end{equation}

\end_inset


\end_layout

\begin_layout Proof
Auch dieses Zwischenresultat setze ich in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-4"
nolink "false"

\end_inset

 ein und erhalte.
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\neg A\vee\neg B\right)\\
 & = & 2-\delta\left(A\right)-\delta\left(B\right)-\left(1-\delta\left(A\right)\right)\cdot\left(1-\delta\left(B\right)\right)\\
 & = & 2-\delta\left(A\right)-\delta\left(B\right)-\left(1-\delta\left(B\right)-\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & 2-\delta\left(A\right)-\delta\left(B\right)-1+\delta\left(B\right)+\delta\left(A\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & 2-1+\delta\left(A\right)-\delta\left(A\right)+\delta\left(B\right)-\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & 1+\left(\delta\left(A\right)-\delta\left(A\right)\right)+\left(\delta\left(B\right)-\delta\left(B\right)\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & 1+0+0-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & 1-\delta\left(A\right)\cdot\delta\left(B\right)
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Proof
Ich schreibe auch dieses Zwischenresultat noch einmal zusammenfassend auf:
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{equation}
\delta\left(\neg A\vee\neg B\right)=1-\delta\left(A\right)\cdot\delta\left(B\right)\label{eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-6}
\end{equation}

\end_inset

Dieses Zwischenresultat kann ich endlich in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-2"
nolink "false"

\end_inset

 einfügen und erhalte 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\neg\left(\neg A\vee\neg B\right)\right)\\
 & = & 1-\delta\left(\neg A\vee\neg B\right)\\
 & = & 1-\left(1-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & 1-1+\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & 0+\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & \delta\left(A\right)\cdot\delta\left(B\right)
\end{eqnarray*}

\end_inset

oder wiederum zusammengefasst:
\begin_inset Formula 
\begin{equation}
\delta\left(\neg\left(\neg A\vee\neg B\right)\right)=\delta\left(A\right)\cdot\delta\left(B\right)\label{eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-7}
\end{equation}

\end_inset

Dieses Resultat kann ich in die ursprüngliche Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Zusammenhang-Disjunktion-Konjunktion-Zwischenresultat-1"
nolink "false"

\end_inset

 ein und kann jetzt schreiben:
\begin_inset Formula 
\begin{align*}
 & \delta\left(\neg\left(\neg A\vee\neg B\right)\Leftrightarrow\left(A\wedge B\right)\right)\\
= & 1-\left(\delta\left(\neg\left(\neg A\vee\neg B\right)\right)-\delta\left(A\wedge B\right)\right)^{2}\\
= & 1-\left(\delta\left(A\right)\right)\\
= & 1
\end{align*}

\end_inset

Somit muss gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Eindeutigkeitssatz"
nolink "false"

\end_inset

 gelten,
 dass die Aussage
\begin_inset Formula 
\[
\neg\left(\neg A\vee\neg B\right)\Leftrightarrow\left(A\wedge B\right)
\]

\end_inset

für alle möglichen Aussagen 
\begin_inset Formula $A,B$
\end_inset

 wahr und also ein logischer Satz ist.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Äquivalenz von Implikation und Negation einer Konjunktion 
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung an den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:disjunktive-Normalform-Implikation"
nolink "false"

\end_inset

,
 welcher die Implikation auf die Negation einer speziellen Konjunktion zurückführt:
 Es seien also 
\begin_inset Formula $A$
\end_inset

 und 
\begin_inset Formula $B$
\end_inset

 Metasymbole von Aussagen,
 welche in sich selbst und bezüglich den anderen Symbolen des Satzes widerspruchsfrei seien.
 Dann gilt:
\begin_inset Formula 
\[
\left(A\Rightarrow B\right)\Leftrightarrow\neg\left(A\wedge\neg B\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Aequivalenz"
nolink "false"

\end_inset

 kann ich schreiben
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(A\Rightarrow B\right)\Leftrightarrow\left(\neg\left(A\wedge\left(\neg B\right)\right)\right)\right)\\
= & 1-\left(\delta\left(A\Rightarrow B\right)-\delta\left(\neg\left(A\wedge\left(\neg B\right)\right)\right)\right)^{2}
\end{align*}

\end_inset

Wenn ich also zeigen kann,
 dass gilt
\begin_inset Formula 
\[
\delta\left(A\Rightarrow B\right)=\delta\left(\neg\left(A\wedge\left(\neg B\right)\right)\right)
\]

\end_inset

dann bin ich also am Ziel meiner Wünsche.
\end_layout

\begin_layout Proof
Da gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Implikation"
nolink "false"

\end_inset

 der Deltanotation der Implikation gelten muss
\begin_inset Formula 
\begin{equation}
\delta\left(A\Rightarrow B\right)=1-\delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)\label{eq:46}
\end{equation}

\end_inset

gilt also noch der Beweis zu erbringen,
 dass ebenfalls
\begin_inset Formula 
\begin{equation}
\delta\left(\neg\left(A\wedge\left(\neg B\right)\right)\right)=1-\delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)\label{eq:47}
\end{equation}

\end_inset

ist.
 Falls Du bereits vertraut bis mit solchen 
\begin_inset Formula $\delta$
\end_inset

\SpecialChar nobreakdash
Notation,
 wirst Du wahrscheinlich die Gleichheit bereits erkannt haben.
 Aber ich schreibe es trotzdem aus.
 Aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 der Deltanotation der Negation gilt 
\begin_inset Formula 
\begin{equation}
\delta\left(\neg\left(A\wedge\left(\neg B\right)\right)\right)=1-\delta\left(A\wedge\left(\neg B\right)\right)\label{eq:48}
\end{equation}

\end_inset

Der Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Konjunktion"
nolink "false"

\end_inset

 der Deltanotation sagt mir nun,
 dass ich schreiben kann:
\begin_inset Formula 
\begin{equation}
\delta\left(A\wedge\left(\neg B\right)\right)=\delta\left(A\right)\cdot\delta\left(\neg B\right)\label{eq:49}
\end{equation}

\end_inset

Wiederum kann ich aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 der Deltanotation der Negation schreiben
\begin_inset Formula 
\[
\delta\left(\neg B\right)=1-\delta\left(B\right)
\]

\end_inset

Dieses Resultat kann kann in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:49"
nolink "false"

\end_inset

 einfügen und erhalte damit
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\wedge\left(\neg B\right)\right)\\
 & = & \delta\left(A\right)\cdot\delta\left(\neg B\right)\\
 & = & \delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)
\end{eqnarray*}

\end_inset

zusammengefasst also 
\begin_inset Formula 
\[
\delta\left(A\wedge\left(\neg B\right)\right)=\delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)
\]

\end_inset

Dieses Ergebnis füge ich nun in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:48"
nolink "false"

\end_inset

 und erhalte:
 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\neg\left(A\wedge\left(\neg B\right)\right)\right)\\
 & = & 1-\delta\left(A\wedge\left(\neg B\right)\right)\\
 & = & 1-\delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)
\end{eqnarray*}

\end_inset

Vergleiche ich dieses Resultat mit der Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:46"
nolink "false"

\end_inset

,
 dann kann ich also 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\wedge\left(\neg B\right)\right)\\
 & = & \delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)\\
 & = & \delta\left(A\Rightarrow B\right)
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Proof
Darum kann ich schreiben
\begin_inset Formula 
\begin{align*}
 & \delta\left(\left(A\Rightarrow B\right)\Leftrightarrow\left(\neg\left(A\wedge\left(\neg B\right)\right)\right)\right)\\
= & 1-\left(\delta\left(A\Rightarrow B\right)-\delta\left(\neg\left(A\wedge\left(\neg B\right)\right)\right)\right)^{2}\\
= & 1-0^{2}\\
= & 1-0\\
= & 1
\end{align*}

\end_inset

Also kann ich gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Eindeutigkeitssatz"
nolink "false"

\end_inset

 schließen,
 dass die Aussage
\begin_inset Formula 
\[
\left(A\Rightarrow B\right)\Leftrightarrow\left(\neg\left(A\wedge\left(\neg B\right)\right)\right)
\]

\end_inset

für alle Aussagen wahr und somit ein logischer Satz ist.
 Darum nehme ich an dieser Stelle an,
 den Satz erbracht zu haben.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Satz der Implikation einer Aussage
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Es sei 
\begin_inset Formula $A$
\end_inset

 ein Metasymbol einer Aussage,
 welches in sich selbst und bezüglich den anderen Symbolen des Satzes widerspruchsfrei sei.
 Dann gilt:
\begin_inset Formula 
\[
A\Rightarrow A
\]

\end_inset


\end_layout

\begin_layout Proof
Aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Implikation"
nolink "false"

\end_inset

 kann ich schreiben:
\begin_inset Formula 
\begin{align*}
 & \delta\left(A\Rightarrow A\right)\\
= & 1-\delta\left(A\right)\cdot\left(1-\delta\left(A\right)\right)
\end{align*}

\end_inset

Nun habe 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:Deltanotation-A-neg-A"
nolink "false"

\end_inset

 muss gelten:
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\left(1-\delta\left(A\right)\right)=0
\]

\end_inset

 Somit hätte ich den Beweis bereits erbracht.
 Also gilt
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\Rightarrow A\right)\\
 & = & 1-\delta\left(A\right)\cdot\left(1-\delta\left(A\right)\right)\\
 & = & 1-0\\
 & = & 1
\end{eqnarray*}

\end_inset

Also kann ich gemäß 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Eindeutigkeitssatz"
nolink "false"

\end_inset

 schließen,
 dass die Aussage 
\begin_inset Formula 
\[
A\Rightarrow A
\]

\end_inset

für alle denkbaren Aussagen 
\begin_inset Formula $A$
\end_inset

 wahr ist.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Über unwahre Aussagen
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Es sei 
\begin_inset Formula $A$
\end_inset

 das Symbol einer Aussage,
 welche in sich selbst und in Bezug auf die anderen Symbolen dieses Beweises widerspruchsfrei sei.
 Dann gilt gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:Existenz-nicht-wahrer-Aussagen"
nolink "false"

\end_inset

 
\begin_inset Formula 
\[
\neg\left(A\wedge\neg A\right)
\]

\end_inset

Ich möchte den Satz an dieser Stelle noch einmal mittels der 
\begin_inset Formula $\delta$
\end_inset

\SpecialChar nobreakdash
Notation zeigen:
