\begin_layout Section
aus Konjunktion folgt Aussage
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung an den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:Implikation-Aussage-aus-Konjunktion"
nolink "false"

\end_inset

:
 Es seien 
\begin_inset Formula $A,B$
\end_inset

 Metasymbole von Aussagen,
 welche weder in sich selbst noch in Bezug auf die anderen Symbole des Satzes widersprüchlich seien.
 Dann gilt
\begin_inset Formula 
\[
A\wedge B\Rightarrow A
\]

\end_inset


\end_layout

\begin_layout Proof
Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Implikation"
nolink "false"

\end_inset

 der Deltanotation der Implikation kann ich schreiben
\begin_inset Formula 
\begin{eqnarray}
\delta\left(A\wedge B\Rightarrow A\right) & = & 1-\delta\left(A\wedge B\right)\cdot\left(1-\delta\left(A\right)\right)\label{eq:53}
\end{eqnarray}

\end_inset

Weiter muss gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Konjunktion"
nolink "false"

\end_inset

 der Deltanotation der Konjunktion gelten
\begin_inset Formula 
\begin{eqnarray*}
\delta\left(A\wedge B\right) & = & \delta\left(A\right)\cdot\delta\left(B\right)
\end{eqnarray*}

\end_inset

Dieses Resultat kann ich die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:53"
nolink "false"

\end_inset

 einsetzen und so erhalte ich
\begin_inset Formula 
\begin{align*}
 & \delta\left(A\wedge B\Rightarrow A\right)\\
= & 1-\delta\left(A\wedge B\right)\cdot\left(1-\delta\left(A\right)\right)\\
= & 1-\delta\left(A\right)\cdot\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)
\end{align*}

\end_inset

oder verkürzt,
 da die Gleichheit von ganzen Zahlen transitiv ist:
\begin_inset Formula 
\begin{equation}
\delta\left(A\wedge B\Rightarrow A\right)=1-\delta\left(A\right)\cdot\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)\label{eq:54}
\end{equation}

\end_inset

Der Minuend
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)
\]

\end_inset

muss nun 
\begin_inset Formula $0$
\end_inset

 sein.
 Da die ganzzahlige Multiplikation kommutativ und assoziativ ist.
 Ich kann darum schreiben:
\begin_inset Formula 
\begin{align}
\delta\left(A\right)\cdot\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)= & \delta\left(A\right)\cdot\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\label{eq:55}
\end{align}

\end_inset

Ich versuchte im Beweis des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:Deltanotation-A-neg-A"
nolink "false"

\end_inset

 zu zeigen,
 dass gelten muss:
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\left(1-\delta\left(A\right)\right)=0
\]

\end_inset

Also muss auch gelten (wenn ich dieses Resultat in der vorletzten Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:55"
nolink "false"

\end_inset

 einsetze:
\begin_inset Formula 
\begin{align*}
 & \delta\left(A\right)\cdot\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)\\
= & \delta\left(A\right)\cdot\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)=0\cdot\delta\left(B\right)\\
= & 0
\end{align*}

\end_inset

oder 
\end_layout

\begin_layout Proof
Somit kann ich gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Eindeutigkeitssatz"
nolink "false"

\end_inset

 folgern,
 das die Aussage
\begin_inset Formula 
\[
A\wedge B\Rightarrow A
\]

\end_inset

unabhängig von den gewählten Aussagen 
\begin_inset Formula $A$
\end_inset

 sowie 
\begin_inset Formula $B$
\end_inset

 immer wahr und somit ein logischer Satz sein muss.
 Dies wollte ich jedoch zeigen.
 Also kann ich den Satz als bewiesen betrachten.
\end_layout

