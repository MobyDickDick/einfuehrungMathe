\end_inset

 ist.
\end_layout

\begin_layout Standard
Nun gibt es mehr oder weniger sinnvolle Arten,
 wie ich für zwei Zahlen der größten gemeinsamen Teiler bestimme.
 Zuerst möchte ich übliche Art der Bestimmung des größten gemeinsamen Teilers zeigen.
\end_layout

\begin_layout Proposition
Es seien 
\begin_inset Formula $n_{1},\,n_{2}\in\mathbb{N}$
\end_inset

 sowie
\begin_inset Formula 
\[
n_{1}=\prod_{k\in\mathbb{\mathbb{N}}}p^{l_{1}\left(k\right)}_{k},\,n_{2}=\prod_{k\in\mathbb{N}}p^{l_{2}\left(k\right)}_{k}
\]

\end_inset

mit 
\begin_inset Formula 
\[
p_{k}\in\mathbb{P}\equiv\mbox{Menge der Primzahlen}
\]

\end_inset

sowie 
\begin_inset Formula 
\[
l_{1}\left(k\right),l_{2}\left(k\right)\in\mathbb{N}_{0}
\]

\end_inset

Dann gilt 
\begin_inset Formula 
\[
\gcd\left(n_{1,}n_{2}\right)=\prod_{k\in\mathbb{\mathbb{N}}}p^{\min\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}
\]

\end_inset


\end_layout

\begin_layout Proof
Es seien 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

 sowie 
\begin_inset Formula 
\[
n_{1}=\prod_{k\in\mathbb{N}}p^{l_{1}\left(k\right)}_{k},\,n_{2}=\prod_{k\in\mathbb{\mathbb{N}}}p^{l_{2}\left(k\right)}_{k}
\]

\end_inset


\end_layout

\begin_layout Proof
und 
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{2}\right)=\prod_{k\in\mathbb{N}}p^{l_{3}\left(k\right)}_{k}
\]

\end_inset

mit 
\begin_inset Formula 
\[
p_{k}\in\mathbb{P}\equiv\mbox{Menge der Primzahlen}
\]

\end_inset

sowie für alle 
\begin_inset Formula $k\in\mathbb{N}$
\end_inset

 
\begin_inset Formula 
\[
l_{1}\left(k\right),l_{2}\left(k\right),l_{3}\left(k\right)\in\mathbb{N}_{0}
\]

\end_inset

also muss gelten
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{n_{1}}{\gcd\left(n_{1},n_{2}\right)}\\
 & = & \frac{\prod_{k\in\mathbb{\mathbb{N}}}p^{l_{1}\left(k\right)}_{k}}{\prod_{k\in\mathbb{N}}p^{l_{3}\left(k\right)}_{k}}\\
 & = & \prod_{k\in\mathbb{N}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}
\end{eqnarray*}

\end_inset

und entsprechend
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{n_{2}}{\gcd\left(n_{1},n_{2}\right)}\\
 & = & \frac{\prod_{k\in\mathbb{\mathbb{N}}}p^{l_{2}\left(k\right)}_{k}}{\prod_{k\in\mathbb{N}}p^{l_{3}\left(k\right)}_{k}}\\
 & = & \prod_{k\in\mathbb{N}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}
\end{eqnarray*}

\end_inset

Gäbe es eine Zahl 
\begin_inset Formula $m\in\mathbb{N}\backslash\left\{ 1\right\} $
\end_inset

 derart,
 dass 
\begin_inset Formula 
\[
\frac{\frac{n_{1}}{\gcd\left(n_{1},n_{2}\right)}}{m}=\frac{n_{1}}{m\cdot\gcd\left(n_{1},n_{2}\right)}\in\mathbb{N}
\]

\end_inset

sowie
\begin_inset Formula 
\[
\frac{\frac{n_{2}}{\gcd\left(n_{1},n_{2}\right)}}{m}=\frac{n_{2}}{m\cdot\gcd\left(n_{1},n_{2}\right)}\in\mathbb{N}
\]

\end_inset

dann wäre
\begin_inset Formula 
\[
m\cdot\gcd\left(n_{1},n_{2}\right)>\gcd\left(n_{1},n_{2}\right)
\]

\end_inset

der größte gemeinsame Teiler,
 jedoch im Widerspruch zur Definition über den größten gemeinsamen Teiler.
 Also kann eine solche Zahl nicht existieren.
 Ich nehme an,
 dass es ein 
\begin_inset Formula $k_{0}\in\mathbb{N}$
\end_inset

 derart gäbe,
 dass gilt
\begin_inset Formula 
\[
l_{1}\left(k_{0}\right)-l_{3}\left(k_{0}\right)>0\wedge l_{2}\left(k_{0}\right)-l_{3}\left(k_{0}\right)>0
\]

\end_inset

Dann müsste mit 
\begin_inset Formula 
\[
\rho\equiv\min\left\{ l_{1}\left(k_{0}\right)-l_{3}\left(k_{0}\right),\,l_{2}\left(k_{0}\right)-l_{3}\left(k_{0}\right)\right\} >0
\]

\end_inset

 gelten 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{\frac{n_{1}}{\gcd\left(n_{1},n_{2}\right)}}{p^{\rho}_{k\left(0\right)}}\\
 & = & \frac{\prod_{k\in\mathbb{N}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}}{p^{\rho}_{k\left(0\right)}}\\
 & = & \frac{\prod_{k\in\mathbb{N}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}}{p^{\rho}_{k\left(0\right)}}\\
 & = & \prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k<k\left(0\right)
\end{array}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}\cdot p^{l_{1}\left(k\right)-l_{3}\left(k\right)-\rho}_{k\left(0\right)}\cdot\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k>k\left(0\right)
\end{array}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}\in\mathbb{N}
\end{eqnarray*}

\end_inset

da mit 
\begin_inset Formula 
\[
\rho\leq l_{1}\left(k\right)-l_{3}\left(k\right)
\]

\end_inset

eben gilt
\begin_inset Formula 
\[
0\leq l_{1}\left(k\right)-l_{3}\left(k\right)-\rho
\]

\end_inset

und somit
\begin_inset Formula 
\[
p^{l_{1}\left(k\right)-l_{3}\left(k\right)-m}_{k\left(0\right)}\geq p^{0}_{k\left(0\right)}=1
\]

\end_inset

also 
\begin_inset Formula 
\[
p^{l_{1}\left(k\right)-l_{3}\left(k\right)-\rho}_{k\left(0\right)}\in\mathbb{N}
\]

\end_inset

Mit 
\begin_inset Formula 
\[
\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k<k\left(0\right)
\end{array}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}\in\mathbb{N}
\]

\end_inset

und
\begin_inset Formula 
\[
\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k>k\left(0\right)
\end{array}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}\in\mathbb{N}
\]

\end_inset

muss also das Produkt dreier natürlicher Zahlen immer noch natürlich sein.
 Auf haargenau gleiche Art kann ich zeigen,
 dass ebenfalls gelten müsste:
\begin_inset Formula 
\[
\frac{\frac{n_{2}}{\gcd\left(n_{1},n_{2}\right)}}{p^{\rho}_{k\left(0\right)}}\in\mathbb{N}
\]

\end_inset


\end_layout

\begin_layout Proof
Denn es müsste gelten:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{\frac{n_{2}}{\gcd\left(n_{1},n_{2}\right)}}{p^{\rho}_{k\left(0\right)}}\\
 & = & \frac{\prod_{k\in\mathbb{N}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}}{p^{\rho}_{k\left(0\right)}}\\
 & = & \prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k<k\left(0\right)
\end{array}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}\cdot p^{l_{2}\left(k\right)-l_{3}\left(k\right)-\rho}_{k\left(0\right)}\cdot\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k>k\left(0\right)
\end{array}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}\in\mathbb{N}
\end{eqnarray*}

\end_inset

da mit 
\begin_inset Formula 
\[
\rho\leq l_{2}\left(k\right)-l_{3}\left(k\right)
\]

\end_inset

eben gilt
\begin_inset Formula 
\[
0\leq l_{2}\left(k\right)-l_{3}\left(k\right)-\rho
\]

\end_inset

und somit
\begin_inset Formula 
\[
p^{l_{2}\left(k\right)-l_{3}\left(k\right)-m}_{k\left(0\right)}\geq p^{0}_{k\left(0\right)}=1
\]

\end_inset

also 
\begin_inset Formula 
\[
p^{l_{2}\left(k\right)-l_{3}\left(k\right)-\rho}_{k\left(0\right)}\in\mathbb{N}
\]

\end_inset

Mit 
\begin_inset Formula 
\[
\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k<k\left(0\right)
\end{array}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}\in\mathbb{N}
\]

\end_inset

und
\begin_inset Formula 
\[
\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k>k\left(0\right)
\end{array}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}\in\mathbb{N}
\]

\end_inset

muss also das Produkt dreier natürlicher Zahlen immer noch natürlich sein.
 
\end_layout

\begin_layout Proof
Also hätte ich mit 
\begin_inset Formula 
\[
m\equiv p^{\rho}_{k\left(0\right)}\geq p_{k\left(0\right)}>1
\]

\end_inset

und
\begin_inset Formula 
\[
\frac{\frac{n_{1}}{\gcd\left(n_{1},n_{2}\right)}}{m}\in\mathbb{N}
\]

\end_inset

sowie
\begin_inset Formula 
\[
\frac{\frac{n_{2}}{\gcd\left(n_{1},n_{2}\right)}}{m}\in\mathbb{N}
\]

\end_inset

eine natürliche Zahl 
\begin_inset Formula $m$
\end_inset

 gefunden,
 welche sowohl ein Teiler von 
\begin_inset Formula 
\[
\frac{n_{1}}{\gcd\left(n_{1},n_{2}\right)}
\]

\end_inset

wie auch von
\begin_inset Formula 
\[
\frac{n_{2}}{\gcd\left(n_{1},n_{2}\right)}
\]

\end_inset

wäre - was jedoch wiederum ein Widerspruch zur Definition vom größten gemeinsamen Teiler wäre.
 Darum muss für alle 
\begin_inset Formula $k\in\mathbb{N}$
\end_inset

 gelten
\begin_inset Formula 
\[
\min\left\{ l_{1}\left(k_{0}\right)-l_{3}\left(k_{0}\right),\,l_{2}\left(k_{0}\right)-l_{3}\left(k_{0}\right)\right\} \leq0
\]

\end_inset

also 
\begin_inset Formula 
\[
l_{1}\left(k\right)\leq l_{3}\left(k\right)\vee l_{2}\left(k\right)\leq l_{3}\left(k\right)
\]

\end_inset

Also muss gelten
\begin_inset Formula 
\[
\min\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} \leq l_{3}\left(k\right)
\]

\end_inset

Wäre nun für ein 
\begin_inset Formula $k_{1}\in\mathbb{N}$
\end_inset

 
\begin_inset Formula 
\[
\nu\equiv\min\left\{ l_{1}\left(k_{1}\right),l_{2}\left(k_{1}\right)\right\} <l_{3}\left(k_{1}\right)
\]

\end_inset

dann kann ich eine Fallunterscheidung machen.
 Wäre etwa 
\begin_inset Formula 
\[
l_{1}\left(k_{1}\right)<l_{3}\left(k_{1}\right)
\]

\end_inset

 dann müsste gelten
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{n_{1}}{\gcd\left(n_{1},n_{2}\right)}\\
 & = & \prod_{k\in\mathbb{N}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}\\
 & = & \prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k<k\left(1\right)
\end{array}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}\cdot p^{l_{1}\left(k\left(1\right)\right)-\nu}_{k\left(1\right)}\cdot\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k>k\left(1\right)
\end{array}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}
\end{eqnarray*}

\end_inset

Nun ist 
\begin_inset Formula 
\[
l_{1}\left(k\right)-\nu<0
\]

\end_inset

und somit das Produkt oben gleich
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{n_{1}}{\gcd\left(n_{1},n_{2}\right)}\\
 & = & \frac{\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k<k\left(1\right)
\end{array}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}\cdot\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k>k\left(1\right)
\end{array}}p^{l_{1}\left(k\right)-l_{3}\left(k\right)}_{k}}{p^{\nu-l_{1}\left(k\left(1\right)\right)}_{k\left(1\right)}}
\end{eqnarray*}

\end_inset

Da nun 
\begin_inset Formula $p_{k\left(1\right)}$
\end_inset

 eine Primzahl ist,
 müssen alle positiven Potenzen von 
\begin_inset Formula $p_{k\left(1\right)}$
\end_inset

 zu belieben nicht negativen Potenzen der anderen Primzahlen teilerfremd sein.
 Also würde daraus folgen,
 das
\begin_inset Formula 
\[
\frac{n_{1}}{\gcd\left(n_{1},n_{2}\right)}
\]

\end_inset

keine natürliche Zahl wäre,
 was ebenfalls der Voraussetzung über den größten gemeinsamen Teiler widerspricht.
 Das wäre ebenfalls der Fall,
 falls gelten würde:
\end_layout

\begin_layout Proof
\begin_inset Formula 
\[
l_{2}\left(k_{1}\right)<l_{3}\left(k_{1}\right)
\]

\end_inset

 Denn dann müsste gelten
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{n_{2}}{\gcd\left(n_{1},n_{2}\right)}\\
 & = & \prod_{k\in\mathbb{N}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}\\
 & = & \prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k<k\left(1\right)
\end{array}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}\cdot p^{l_{2}\left(k\left(1\right)\right)-\nu}_{k\left(1\right)}\cdot\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k>k\left(1\right)
\end{array}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}
\end{eqnarray*}

\end_inset

Nun wäre 
\begin_inset Formula 
\[
l_{2}\left(k\right)-\nu<0
\]

\end_inset

und somit das Produkt oben gleich
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{n_{2}}{\gcd\left(n_{1},n_{2}\right)}\\
 & = & \frac{\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k<k\left(1\right)
\end{array}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}\cdot\prod_{\begin{array}{c}
k\in\mathbb{N}\wedge\\
k>k\left(1\right)
\end{array}}p^{l_{2}\left(k\right)-l_{3}\left(k\right)}_{k}}{p^{\nu-l_{2}\left(k\left(1\right)\right)}_{k\left(1\right)}}
\end{eqnarray*}

\end_inset

Da nun 
\begin_inset Formula $p_{k\left(1\right)}$
\end_inset

 eine Primzahl ist,
 müssen alle positiven Potenzen von 
\begin_inset Formula $p_{k\left(1\right)}$
\end_inset

 zu belieben nicht negativen Potenzen der anderen Primzahlen teilerfremd sein.
 Also würde daraus folgen,
 das
\begin_inset Formula 
\[
\frac{n_{2}}{\gcd\left(n_{1},n_{2}\right)}
\]

\end_inset

keine natürliche Zahl wäre,
 was wiederum der Voraussetzung über den größten gemeinsamen Teiler widerspricht.
 Also muss für alle 
\begin_inset Formula $k\in\mathbb{N}$
\end_inset

 gelten
\begin_inset Formula 
\[
\min\left\{ l_{1}\left(k_{1}\right),l_{2}\left(k_{1}\right)\right\} =l_{3}\left(k_{1}\right)
\]

\end_inset

und somit habe ich meines Erachtens die Formel
\begin_inset Formula 
\[
\gcd\left(n_{1,}n_{2}\right)=\prod_{k\in\mathbb{N}}p^{l_{3}\left(k\right)}_{k}=\prod_{k\in\mathbb{\mathbb{N}}}p^{\min\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}
\]

\end_inset

bewiesen.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
Ich möchte zuerst einen Hilfssatz formulieren und beweisen,
 der da lautet:
\end_layout

\begin_layout Lemma
\begin_inset CommandInset label
LatexCommand label
name "lem:Beschraenkung-von-gcd-gegen-oben"

\end_inset

Es seien 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

.
 Dann ist
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{2}\right)\leq\min\left\{ n_{1},n_{2}\right\} 
\]

\end_inset


\end_layout

\begin_layout Proof
Es ist
\begin_inset Formula 
\begin{eqnarray*}
 &  & \gcd\left(n_{1},n_{2}\right)\\
 & = & \prod_{k\in\mathbb{\mathbb{N}}}p^{\min\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}\\
 & \leq & \prod_{k\in\mathbb{\mathbb{N}}}p^{l_{1}\left(k\right)}_{k}\\
 & = & n_{1}
\end{eqnarray*}

\end_inset

und ebenso 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \gcd\left(n_{1},n_{2}\right)\\
 & = & \prod_{k\in\mathbb{\mathbb{N}}}p^{\min\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}\\
 & \leq & \prod_{k\in\mathbb{\mathbb{N}}}p^{l_{2}\left(k\right)}_{k}\\
 & = & n_{1}
\end{eqnarray*}

\end_inset

Also ist
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{2}\right)\leq\min\left\{ n_{1},n_{2}\right\} 
\]

\end_inset

so wie ich es behauptet habe.
 Darum glaube ich,
 den Satz als bewiesen betrachten zu können.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
Ich habe übrigens ganz lang nicht gewusst,
 dass der größte gemeinsame Teiler zweier natürlicher Zahlen 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

 auch eleganter ermittelt werden kann:
\end_layout

\begin_layout Proposition
\begin_inset CommandInset label
LatexCommand label
name "prop:Euklidsche-Algorithmus"

\end_inset


\begin_inset Index idx
range none
pageformat default
status open

\begin_layout Plain Layout
Euklidische Algorithmus
\end_layout

\end_inset

Es seien 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

.
 Dann kann der größte gemeinsame Teiler 
\begin_inset Formula $\gcd\left(n_{1},n_{2}\right)$
\end_inset

 von 
\begin_inset Formula $n_{1}$
\end_inset

 und 
\begin_inset Formula $n_{2}$
\end_inset

 wie folgt ermittelt werden.
\end_layout

\begin_layout Proposition
1) Bestimme 
\begin_inset Formula $n_{3}\equiv\max\left\{ n_{1},n_{2}\right\} $
\end_inset

 und 
\begin_inset Formula $n_{4}\equiv\min\left\{ n_{1},n_{2}\right\} $
\end_inset


\end_layout

\begin_layout Proposition
2) Bestimme 
\begin_inset Formula $n_{5}\equiv n_{3}\mod n_{4}$
\end_inset


\end_layout

\begin_layout Proposition
3) Ist 
\begin_inset Formula $n_{5}=0$
\end_inset

,
 dann ist 
\begin_inset Formula $n_{4}=\gcd\left(n_{1},n_{3}\right)$
\end_inset


\end_layout

\begin_layout Proposition
4) Ist 
\begin_inset Formula $n_{5}>0$
\end_inset

,
 dann setze 
\begin_inset Formula $n_{3}\equiv n_{4}$
\end_inset

 und 
\begin_inset Formula $n_{4}\equiv n_{5}$
\end_inset

.
 Gehe anschließend wieder zu 2)
\end_layout

\begin_layout Proof
Das Beweisen von Algorithmen ist so eine Sache.
 Denn ich finde es sehr schwierig,
 die Richtigkeit von einem Algorithmus zu beweisen.
 Ist 
\begin_inset Formula $n_{1}=n_{2}$
\end_inset

,
 dann ist 
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{2}\right)=\gcd\left(n_{1},n_{1}\right)=n_{1}
\]

\end_inset

Denn es ist 
\begin_inset Formula 
\[
\frac{n_{1}}{n_{1}}=1\in\mathbb{N}
\]

\end_inset

Gemäß dem vorhergehenden Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:Beschraenkung-von-gcd-gegen-oben"
nolink "false"

\end_inset

 muss 
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{1}\right)\leq n_{1}
\]

\end_inset

 sein.
 Also ist 
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{1}\right)=n_{1}
\]

\end_inset

Wird jetzt der euklidische Algorithmus angewendet,
 dann ist 
\begin_inset Formula 
\[
n_{1}\mod n_{1}=0
\]

\end_inset

 und somit ist 
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{1}\right)=0
\]

\end_inset

Also ist in diesem Fall der euklidische Algorithmus richtig.
 Somit kann ich im folgenden 
\begin_inset Formula $n_{1}\neq n_{2}$
\end_inset

 annehmen.
\end_layout

\begin_layout Proof
Sicher ist für 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

 
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{2}\right)=\gcd\left(n_{2},n_{1}\right)
\]

\end_inset

Denn es ist 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \gcd\left(n_{1,}n_{2}\right)\\
 & = & \prod_{k\in\mathbb{\mathbb{N}}}p^{\min\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}\\
 & = & \prod_{k\in\mathbb{\mathbb{N}}}p^{\min\left\{ l_{2}\left(k\right),l_{2}\left(k\right)\right\} }_{k}\\
 & = & \gcd\left(n_{2},n_{1}\right)
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Proof
Weiter ist 
\begin_inset Formula 
\[
\left\{ \min\left\{ n_{1},n_{2}\right\} ,\max\left\{ n_{1},n_{2}\right\} \right\} =\left\{ n_{1},n_{2}\right\} 
\]

\end_inset

Ist 
\begin_inset Formula 
\[
n_{1}<n_{2}
\]

\end_inset

dann ist
\begin_inset Formula 
\[
\left\{ \min\left\{ n_{1},n_{2}\right\} ,\max\left\{ n_{1},n_{2}\right\} \right\} =\left\{ n_{1},n_{2}\right\} 
\]

\end_inset

Ist schlussendlich 
\begin_inset Formula 
\[
n_{1}>n_{2}
\]

\end_inset

dann ist
\begin_inset Formula 
\[
\left\{ \min\left\{ n_{1},n_{2}\right\} ,\max\left\{ n_{1},n_{2}\right\} \right\} =\left\{ n_{2},n_{1}\right\} =\left\{ n_{1},n_{2}\right\} 
\]

\end_inset

Also ist 
\begin_inset Formula 
\[
\gcd\left(n_{1,}n_{2}\right)=\gcd\left(\max\left\{ n_{1},n_{2}\right\} ,\min\left\{ n_{1},n_{2}\right\} \right)
\]

\end_inset

Ich kann also im folgenden annehmen:
\begin_inset Formula 
\[
n_{1}>n_{2}
\]

\end_inset

Ist
\begin_inset Formula 
\[
n_{1}\mod n_{2}=0
\]

\end_inset

dann ist 
\begin_inset Formula $n_{2}$
\end_inset

 ein Teiler von 
\begin_inset Formula $n_{1}$
\end_inset

.
 Also ist,
 da gemäß dem Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:Beschraenkung-von-gcd-gegen-oben"
nolink "false"

\end_inset

 oben 
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{2}\right)\leq\min\left\{ n_{1},n_{2}\right\} \leq n_{2}
\]

\end_inset

sein muss.
 Somit möchte ich schlussendlich noch zeigen,
 dass gilt:
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{2}\right)=\gcd\left(n_{2},n_{1}\mbox{\mod{}}n_{2}\right)
\]

\end_inset

falls
\begin_inset Formula 
\[
n_{1}\mbox{\mod{}}n_{2}\neq0
\]

\end_inset

ist.
 Dabei werde gesetzt:
\begin_inset Formula 
\[
n_{1}\mbox{\mod{\ }}n_{2}\equiv n_{1}-n_{2}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor 
\]

\end_inset


\begin_inset Formula 
\[
\gcd\left(n_{2},n_{1}\mbox{\mod{}}n_{2}\right)
\]

\end_inset

muss ein Teiler von 
\begin_inset Formula $n_{2}$
\end_inset

 sein.
 Also muss 
\begin_inset Formula 
\[
\frac{n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\mod{}}n_{2}\right)}\in\mathbb{N}
\]

\end_inset

sowie
\begin_inset Formula 
\[
\frac{n_{1}\mbox{\mod{}}n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}\in\mathbb{N}
\]

\end_inset

Dann ist jedoch auch mit
\begin_inset Formula 
\[
n_{1}=n_{2}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor +n_{1}\mbox{\mod{}}n_{2}\in\mathbb{N}
\]

\end_inset

Weiter kann ich schreiben
\end_layout

\begin_layout Proof
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{n_{1}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}\\
 & = & \frac{n_{2}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor +n_{1}\mbox{\mod{}}n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}\\
 & = & \frac{n_{2}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor }{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}+\frac{n_{1}\mbox{\mod{}}n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}\\
 & = & \frac{n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor +\frac{n_{1}\mbox{\mod{}}n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}
\end{eqnarray*}

\end_inset

Dann nun
\begin_inset Formula 
\begin{eqnarray*}
\frac{n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)} & \in & \mathbb{N}\\
\frac{n_{1}\mbox{\mod{}}n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)} & \in & \mathbb{N}
\end{eqnarray*}

\end_inset

sowie nach wegen 
\begin_inset Formula 
\[
n_{1}\geq n_{1}
\]

\end_inset

ebenfalls
\begin_inset Formula 
\[
\frac{n_{1}}{n_{2}}\geq1
\]

\end_inset

und somit
\begin_inset Formula 
\[
\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor \geq1\in\mathbb{N}
\]

\end_inset

ist,
 muss also 
\begin_inset Formula 
\[
\frac{n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor +\frac{n_{1}\mbox{\mod{}}n_{2}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}\in\mathbb{N}
\]

\end_inset

sein.
 Also ist auch
\begin_inset Formula 
\[
\frac{n_{1}}{\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)}\in\mathbb{N}
\]

\end_inset

Somit ist 
\begin_inset Formula 
\[
\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)
\]

\end_inset

ein Teiler von 
\begin_inset Formula $n_{1}$
\end_inset

 und 
\begin_inset Formula $n_{2}$
\end_inset

 und somit also ein gemeinsamer Teiler von 
\begin_inset Formula $n_{1}$
\end_inset

 und 
\begin_inset Formula $n_{2}$
\end_inset

.
 Es muss darum 
\begin_inset Formula 
\[
\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)\leq\gcd\left(n_{1},n_{2}\right)
\]

\end_inset

gelten.
 Die Preisfrage ist,
 ob 
\begin_inset Formula 
\[
\gcd\left(n_{2},n_{1}\mbox{\ensuremath{\mod{}}}n_{2}\right)
\]

\end_inset

der größte gemeinsame Teiler von 
\begin_inset Formula $n_{1}$
\end_inset

 und 
\begin_inset Formula $n_{2}$
\end_inset

 sein muss.
 Es sei 
\begin_inset Formula $t$
\end_inset

 ein gemeinsamer Teiler von 
\begin_inset Formula $n_{1}$
\end_inset

 und 
\begin_inset Formula $n_{2}$
\end_inset

.
 Also muss gelten
\begin_inset Formula 
\[
\frac{n_{1}}{t}\in\mathbb{N}
\]

\end_inset

und 
\begin_inset Formula 
\[
\frac{n_{2}}{t}\in\mathbb{N}
\]

\end_inset

Dann folgt jedoch auch aus
\begin_inset Formula 
\[
n_{1}=n_{2}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor +n_{1}\mod n_{2}
\]

\end_inset


\begin_inset Formula 
\[
n_{1}\mod n_{2}=n_{1}-n_{2}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor 
\]

\end_inset

und ebenso
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{n_{1}\mod n_{2}}{t}\\
 & = & \frac{n_{1}-n_{2}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor }{t}\\
 & = & \frac{n_{1}}{t}-\frac{n_{2}}{t}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor 
\end{eqnarray*}

\end_inset

Da nun 
\begin_inset Formula $t$
\end_inset

 ein Teiler sowohl von 
\begin_inset Formula $n_{1}$
\end_inset

 wie auch von 
\begin_inset Formula $n_{2}$
\end_inset

 ist,
 muss gelten
\begin_inset Formula 
\[
\frac{n_{2}}{t}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor \in\mathbb{N}
\]

\end_inset

Da 
\begin_inset Formula $n_{2}$
\end_inset

 kein Teiler von 
\begin_inset Formula $n_{1}$
\end_inset

 ist,
 muss gelten
\begin_inset Formula 
\[
n_{1}\mod n_{2}>0
\]

\end_inset

und darum
\begin_inset Formula 
\[
n_{1}-n_{2}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor >0
\]

\end_inset

also 
\begin_inset Formula 
\[
n_{1}>n_{2}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor 
\]

\end_inset

Also ist mit
\begin_inset Formula 
\[
\frac{n_{1}}{t}\in\mathbb{N}
\]

\end_inset

und
\begin_inset Formula 
\[
\frac{n_{2}}{t}\in\mathbb{N}
\]

\end_inset


\end_layout

\begin_layout Proof
\begin_inset Formula 
\[
\frac{n_{1}}{t}>\frac{n_{2}}{t}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor 
\]

\end_inset

und darum auch
\end_layout

\begin_layout Proof
\begin_inset Formula 
\[
\frac{n_{1}}{t}-\frac{n_{2}}{t}\cdot\left\lfloor \frac{n_{1}}{n_{2}}\right\rfloor \in\mathbb{N}
\]

\end_inset

Darum ist auch
\begin_inset Formula 
\[
n_{1}\mod n_{2}\in\mathbb{N}
\]

\end_inset

Also ist jeder gemeinsamer Teiler von 
\begin_inset Formula $n_{1}$
\end_inset

 und 
\begin_inset Formula $n_{2}$
\end_inset

 auch ein Teiler von
\begin_inset Formula 
\[
n_{1}\mod n_{2}
\]

\end_inset

Das bedeutet jedoch auch,
 dass der größte gemeinsame Teiler von 
\begin_inset Formula $n_{1}$
\end_inset

 und 
\begin_inset Formula $n_{2}$
\end_inset

 auch ein Teiler von 
\begin_inset Formula $n_{2}$
\end_inset

 und 
\begin_inset Formula $n_{1}\mod n_{2}$
\end_inset

 und somit kleiner oder gleich dem größten gemeinsamen Teiler von 
\begin_inset Formula $n_{2}$
\end_inset

 und 
\begin_inset Formula $n_{1}$
\end_inset

 ist,
 formal geschrieben
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{2}\right)\le\gcd\left(n_{2},n_{1}\mod n_{2}\right)
\]

\end_inset

Somit kann ich schreiben:
\begin_inset Formula 
\[
\gcd\left(n_{2},n_{1}\mod n_{2}\right)\leq\gcd\left(n_{1},n_{2}\right)\leq\gcd\left(n_{2},n_{1}\mod n_{2}\right)
\]

\end_inset

also schlussendlich 
\begin_inset Formula 
\[
\gcd\left(n_{2},n_{1}\mod n_{2}\right)=\gcd\left(n_{1},n_{2}\right)
\]

\end_inset

Damit habe ich den Schritt von 4) nach 2) gezeigt:
 Wenn kein Teiler von 
\begin_inset Formula $n_{1}$
\end_inset

 ist,
 dann bestimme den größten gemeinsamen Teiler von 
\begin_inset Formula $n_{2}$
\end_inset

 und 
\begin_inset Formula $n_{1}\mod n_{2}$
\end_inset

.
 Also behaupte ich,
 den Beweis erbracht zu haben.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Chapter
Minimum und Maximum
\begin_inset CommandInset label
LatexCommand label
name "chap:Minimum--und-Maximum"

\end_inset


\end_layout

\begin_layout Standard
Dieses Kapitel ist winzig.
 Es stellt bloß zwei kleine Begriffe vor.
\end_layout

\begin_layout Definition
Es seien 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

.
 Dann sei
\begin_inset Formula 
\[
\min\left\{ x,y\right\} \equiv\begin{cases}
x & \Leftarrow x\leq y\\
y & \Leftarrow x>y
\end{cases}
\]

\end_inset

sowie
\begin_inset Formula 
\[
\max\left\{ x,y\right\} \equiv\begin{cases}
y & \Leftarrow x\leq y\\
x & \Leftarrow x>y
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Standard
Und nun möchte ich zeigen:
\end_layout

\begin_layout Lemma
\begin_inset CommandInset label
LatexCommand label
name "lem:Min-Max-Lemma"

\end_inset

Es seien 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

.
 Dann gilt
\begin_inset Formula 
\[
\min\left\{ x,y\right\} =x\cdot\delta_{x\leq y}+y\cdot\delta_{x>y}
\]

\end_inset

respektive 
\begin_inset Formula 
\[
\max\left\{ x,y\right\} =y\cdot\delta_{x\leq y}+x\cdot\delta_{x>y}
\]

\end_inset


\end_layout

\begin_layout Proof
Es seien 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

 und 
\begin_inset Formula $x\leq y$
\end_inset

.
 Dann ist
\begin_inset Formula 
\[
x\cdot\delta_{x\leq y}+y\cdot\delta_{x>y}=x\cdot1+y\cdot0=x=\min\left\{ x,y\right\} 
\]

\end_inset

respektive 
\begin_inset Formula 
\[
y\cdot\delta_{x\leq y}+x\cdot\delta_{x>y}=y\cdot1+x\cdot0=y=\max\left\{ x,y\right\} 
\]

\end_inset

Ist jedoch 
\begin_inset Formula $x>y$
\end_inset

,
 dann gilt
\begin_inset Formula 
\[
x\cdot\delta_{x\leq y}+y\cdot\delta_{x>y}=x\cdot0+y\cdot1=1=\min\left\{ x,y\right\} 
\]

\end_inset

sowie
\begin_inset Formula 
\[
y\cdot\delta_{x\leq y}+x\cdot\delta_{x>y}=y\cdot0+x\cdot1=y=\max\left\{ x,y\right\} 
\]

\end_inset

Also gilt in allen Fällen 
\begin_inset Formula 
\[
x\cdot\delta_{x\leq y}+y\cdot\delta_{x>y}=\min\left\{ x,y\right\} 
\]

\end_inset

sowie
\begin_inset Formula 
\[
y\cdot\delta_{x\leq y}+x\cdot\delta_{x>y}=\max\left\{ x,y\right\} 
\]

\end_inset

Das sind jedoch gerade die Behauptungen von Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "lem:Min-Max-Lemma"
nolink "false"

\end_inset

.
 Damit habe ich den Beweis erbracht.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
Das eben formulierte Lemma ist ja schon gut und recht.
 Jedoch ist es irgendwie 
\begin_inset Quotes gld
\end_inset

unsymmetrisch
\begin_inset Quotes grd
\end_inset

.
 Ich möchte daher ein Lemma formulieren und beweisen,
 welches symmetrischer daherkommt:
\end_layout

\begin_layout Lemma
Es seien 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

.
 Dann ist
\end_layout

\begin_layout Lemma
\begin_inset Formula 
\begin{eqnarray*}
\min\left\{ x,y\right\}  & = & x\cdot\delta_{x\leq y}+y\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}\\
\max\left\{ x,y\right\}  & = & y\cdot\delta_{x\leq y}+x\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Proof
Es seien 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

 sowie 
\begin_inset Formula $x<y$
\end_inset

.
 Dann ist
\begin_inset Formula 
\[
x\cdot\delta_{x\leq y}+y\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}=x\cdot1+y\cdot0-x\cdot0=x+0-0=x=\min\left\{ x,y\right\} 
\]

\end_inset

Ist 
\begin_inset Formula $x=y$
\end_inset

,
 dann kann ich schreiben:
\begin_inset Formula 
\begin{align*}
 & x\cdot\delta_{x\leq y}+y\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}\\
= & x\cdot1+y\cdot1-x\cdot1\\
= & x+y-x\\
= & 0+y\\
= & y
\end{align*}

\end_inset

Da nun gemäß Voraussetzung 
\begin_inset Formula $x=y$
\end_inset

 ist muss eben auch 
\begin_inset Formula $y=x$
\end_inset

 gelten.
 Darum kann ich schreiben 
\begin_inset Formula 
\begin{align*}
 & x\cdot\delta_{x\leq y}+y\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}\\
= & y\\
= & x\\
= & \min\left\{ x,y\right\} 
\end{align*}

\end_inset

Ist schlussendlich 
\begin_inset Formula $x>y$
\end_inset

,
 dann muss gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:Implikation-Disjunktion-aus-Aussage"
nolink "false"

\end_inset

 gelten:
 
\begin_inset Formula 
\[
x>y\Rightarrow x\geq y
\]

\end_inset

Somit muss gemäß der Definition des Kronecker-Symbols (vergleiche mit Definition 
\begin_inset CommandInset ref
LatexCommand ref
reference "def:Kronecker-Symbol"
nolink "false"

\end_inset

) gelten
\begin_inset Formula 
\[
\delta_{x\geq y}=1
\]

\end_inset

Also kann ich schreiben:
\begin_inset Formula 
\[
x\cdot\delta_{x\leq y}+y\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}=x\cdot0+y\cdot1-x\cdot0=0+y-0=y=\min\left\{ x,y\right\} 
\]

\end_inset

 
\end_layout

\begin_layout Proof
Genau die gleiche Überlegung kann ich für die Beschreibung von 
\begin_inset Formula $\max$
\end_inset

 anstellen:Es seien 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

 sowie 
\begin_inset Formula $x<y$
\end_inset

.
 Dann ist
\begin_inset Formula 
\[
y\cdot\delta_{x\leq y}+x\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}=y\cdot1+x\cdot0-x\cdot0=y+0-0=y=\max\left\{ x,y\right\} 
\]

\end_inset

Ist 
\begin_inset Formula $x=y$
\end_inset

,
 dann kann ich schreiben:
\begin_inset Formula 
\begin{align*}
 & x\cdot\delta_{x\leq y}+y\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}\\
= & x\cdot1+y\cdot1-x\cdot1\\
= & x+y-x\\
= & 0+y\\
= & y
\end{align*}

\end_inset

Da nun gemäß Voraussetzung 
\begin_inset Formula $x=y$
\end_inset

 ist muss eben auch 
\begin_inset Formula $y=x$
\end_inset

 gelten.
 Darum kann ich schreiben 
\begin_inset Formula 
\begin{align*}
 & x\cdot\delta_{x\leq y}+y\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}\\
= & y\\
= & x\\
= & \max\left\{ x,y\right\} 
\end{align*}

\end_inset

Ist schlussendlich 
\begin_inset Formula $x>y$
\end_inset

,
 dann muss gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:Implikation-Disjunktion-aus-Aussage"
nolink "false"

\end_inset

 gelten:
 
\begin_inset Formula 
\[
x>y\Rightarrow x\geq y
\]

\end_inset

Somit muss gemäß der Definition des Kronecker-Symbols (vergleiche mit Definition 
\begin_inset CommandInset ref
LatexCommand ref
reference "def:Kronecker-Symbol"
nolink "false"

\end_inset

) gelten
\begin_inset Formula 
\[
\delta_{x\geq y}=1
\]

\end_inset

Also kann ich schreiben:
\begin_inset Formula 
\[
y\cdot\delta_{x\leq y}+x\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}=y\cdot0+x\cdot1-x\cdot0=0+x-0=x=\max\left\{ x,y\right\} 
\]

\end_inset

Somit muss wiederum für alle möglichen 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

 gelten
\begin_inset Formula 
\[
\max\left\{ x,y\right\} =y\cdot\delta_{x\leq y}+x\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}
\]

\end_inset

Somit glaube ich,
 für alle 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

 die Behauptung und somit die Behauptung insgesamt bewiesen zu haben.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
Ich möchte nun zeigen:
\end_layout

\begin_layout Proposition
Es seien 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

.
 Dann gilt
\begin_inset Formula 
\begin{align*}
\min\left\{ x,y\right\}  & =-\max\left\{ -x,-y\right\} \\
\max\left\{ x,y\right\}  & =-\min\left\{ -x,-y\right\} 
\end{align*}

\end_inset


\end_layout

\begin_layout Proof
Es seien 
\begin_inset Formula $x,y\in\mathbb{R}$
\end_inset

.
 Dann gilt
\begin_inset Formula 
\begin{align*}
 & -\max\left\{ -x,-y\right\} \\
= & -\left(-y\cdot\delta_{-x\leq-y}+\left(-x\right)\cdot\delta_{-x\geq-y}-\left(-x\right)\cdot\delta_{-x=-y}\right)\\
= & y\cdot\delta_{-x\leq-y}-\left(-x\right)\cdot\delta_{-x\geq-y}+\left(-x\right)\cdot\delta_{-x=-y}\\
= & y\cdot\delta_{-x\leq-y}+x\cdot\delta_{-x\geq-y}+\left(-x\right)\cdot\delta_{-x=-y}\\
= & x\cdot\delta_{-x\geq-y}+y\cdot\delta_{-x\leq-y}-x\cdot\delta_{-x=-y}
\end{align*}

\end_inset

Nun ist 
\begin_inset Formula $-x\geq-y$
\end_inset

 genau dann wahr,
 falls 
\begin_inset Formula 
\[
x\leq y
\]

\end_inset

ist.
 Also muss 
\begin_inset Formula 
\[
\delta_{-x\geq-y}=\delta_{x\leq y}
\]

\end_inset

sein.
 Ebenso ist 
\begin_inset Formula $-x\leq-y$
\end_inset

 genau dann wahr,
 falls 
\begin_inset Formula 
\[
x\geq y
\]

\end_inset

ist.
 Somit ist also auch 
\begin_inset Formula 
\[
\delta_{-x\leq-y}=\delta_{x\geq y}
\]

\end_inset

und somit ist 
\begin_inset Formula 
\[
-x=-y
\]

\end_inset

genau dann wahr,
 falls 
\begin_inset Formula 
\[
x=y
\]

\end_inset

ist.
 Also muss gelten
\begin_inset Formula 
\[
\delta_{-x=-y}=\delta_{x=y}
\]

\end_inset

Diese Resultate kann ich die obige Rechnung einsetzen und ich erhalte
\begin_inset Formula 
\begin{align*}
 & -\max\left\{ -x,-y\right\} \\
= & x\cdot\delta_{-x\geq-y}+y\cdot\delta_{-x\leq-y}+x\cdot\delta_{-x\geq-y}-x\cdot\delta_{-x=-y}\\
= & x\cdot\delta_{-x\geq-y}+y\cdot\delta_{-x\leq-y}-x\cdot\delta_{-x=-y}\\
= & x\cdot\delta_{x\leq y}+y\cdot\delta_{x\geq y}-x\cdot\delta_{x=y}\\
= & \min\left\{ x,y\right\} 
\end{align*}

\end_inset

Um nun zu zeigen,
 dass
\begin_inset Formula 
\[
-\min\left\{ -x,-y\right\} =\max\left\{ x,y\right\} 
\]

\end_inset

ist,
 mache ich den Ansatz
\begin_inset Formula 
\begin{align*}
t & \equiv-x\\
u & \equiv-y
\end{align*}

\end_inset

Dann muss gelten
\begin_inset Formula 
\begin{align*}
 & -\min\left\{ t,u\right\} \\
= & \max\left\{ -t,-u\right\} \\
= & \max\left\{ -\left(-x\right),-\left(-y\right)\right\} \\
= & \max\left\{ x,y\right\} 
\end{align*}

\end_inset

womit auch diese Behauptung glücklich bewiesen worden wäre.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
Und für was soll das gut sein?
 Das ist natürlich die Preisfrage.
 Es geht darum,
 dass die Bestimmung des Minimums sowie des Maximums immer irgendwie aufwändig und mühsam durchzuführen ist.
 Also ist es einfacher,
 wenn die Bestimmung des Minimum oder des Maximum mittels eines algebraischen Ausdrucks anstelle einer Fallunterscheidung getroffen werden kann.
 
\end_layout

\begin_layout Chapter
kleinstes gemeinsames Vielfache
\end_layout

\begin_layout Definition
Es seien 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

.
 Dann heiße 
\begin_inset Formula 
\[
\mbox{lcm}\left(n_{1},n_{2}\right)
\]

\end_inset

das kleinste gemeinsame Vielfache (
\lang english
lowest common multiple
\lang ngerman
) von 
\begin_inset Formula $n_{1}$
\end_inset

 und 
\begin_inset Formula $n_{2}$
\end_inset

,
 falls gelte:
 
\begin_inset Formula 
\[
\mbox{lcm}\left(n_{1},n_{2}\right)=\min\left\{ n_{5}\in\mathbb{N}\biggm|\exists n_{3},n_{4}\in\mathbb{N}:\,n_{5}=n_{1}\cdot n_{3}=n_{2}\cdot n_{4}\right\} 
\]

\end_inset

Natürlich muss ich jetzt zeigen,
 dass dieses kleinste gemeinsame Vielfache auch wirklich für alle 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

 existiert.
\end_layout

\begin_layout Proposition
Es seien 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

.
 Dann muss es genau eine natürliche Zahl 
\begin_inset Formula 
\[
\mbox{lcm}\left(n_{1},n_{2}\right)\in\mathbb{N}
\]

\end_inset

 geben.
\end_layout

\begin_layout Proof
Es seien 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

.
 Dann gilt
\begin_inset Formula 
\[
n_{5}=n_{1}\cdot n_{2}=n_{2}\cdot n_{1}
\]

\end_inset

Also ist die Menge
\begin_inset Formula 
\[
\left\{ n_{5}\in\mathbb{N}\biggm|\exists n_{3},n_{4}\in\mathbb{N}:\,n_{5}=n_{1}\cdot n_{3}=n_{2}\cdot n_{4}\right\} 
\]

\end_inset

nicht leer.
 Diese Menge besitzt genau ein kleinstes Element.
 Also ist der Satz bewiesen.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
Nun ist klar dass das kleinste gemeinsame Vielfache existieren muss.
 Die Frage ist jedoch,
 wie ich das kleinste gemeinsame Vielfache finden kann.
 Es gilt:
\end_layout

\begin_layout Proposition
Es seien 
\begin_inset Formula $n_{1},\,n_{2}\in\mathbb{N}$
\end_inset

 sowie
\begin_inset Formula 
\[
n_{1}=\prod_{k\in\mathbb{P}}p^{l_{1}\left(k\right)}_{k},\,n_{2}=\prod_{k\in\mathbb{P}}p^{l_{2}\left(k\right)}_{k}
\]

\end_inset

mit 
\begin_inset Formula 
\[
p_{k}\in\mathbb{P}\equiv\mbox{Menge der Primzahlen}
\]

\end_inset

sowie 
\begin_inset Formula 
\[
l_{1}\left(k\right),l_{2}\left(k\right)\in\mathbb{N}_{0}
\]

\end_inset


\end_layout

\begin_layout Proposition
Dann gilt 
\begin_inset Formula 
\[
\mbox{lcm}\left(n_{1,}n_{2}\right)=\prod_{k\in\mathbb{P}}p^{\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}
\]

\end_inset


\end_layout

\begin_layout Proof
Es seien 
\begin_inset Formula 
\begin{eqnarray*}
n_{3} & = & \prod_{k\in\mathbb{P}}p^{l_{3}\left(k\right)}_{k}\\
n_{4} & = & \prod_{k\in\mathbb{P}}p^{l_{4}\left(k\right)}_{k}
\end{eqnarray*}

\end_inset

mit 
\begin_inset Formula 
\[
\mbox{lcm}\left(n_{1},n_{2}\right)=n_{3}\cdot n_{1}=n_{4}\cdot n_{2}
\]

\end_inset

Also kann ich schreiben 
\begin_inset Formula 
\begin{eqnarray*}
 &  & n_{3}\cdot n_{1}\\
 & = & \prod_{k\in\mathbb{P}}p^{l_{3}\left(k\right)}_{k}\cdot\prod_{k\in\mathbb{P}}p^{l_{1}\left(k\right)}_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{l_{3}\left(k\right)+l_{1}\left(k\right)}_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{l_{4}\left(k\right)+l_{2}\left(k\right)}_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{l_{4}\left(k\right)}_{k}\cdot\prod_{k\in\mathbb{P}}p^{l_{2}\left(k\right)}_{k}\\
 & = & n_{4}\cdot n_{2}
\end{eqnarray*}

\end_inset

und somit gilt für alle 
\begin_inset Formula $k\in\mathbb{N}$
\end_inset


\begin_inset Formula 
\[
l_{1}\left(k\right)+l_{3}\left(k\right)=l_{2}\left(k\right)+l_{4}\left(k\right)
\]

\end_inset

Nun gilt es 
\begin_inset Formula $l_{3}\left(k\right)$
\end_inset

 wie auch 
\begin_inset Formula $l_{4}\left(k\right)$
\end_inset

 möglichst klein zu wählen.
 Wäre für ein 
\begin_inset Formula $k_{0}\in\mathbb{N}$
\end_inset


\begin_inset Formula 
\[
l_{3}\left(k_{0}\right)>0
\]

\end_inset

und 
\begin_inset Formula 
\[
l_{4}\left(k_{0}\right)>0
\]

\end_inset

dann wäre auch für 
\begin_inset Formula 
\begin{eqnarray*}
l'_{3}\left(k_{0}\right) & \equiv & l_{3}\left(k_{0}\right)-\min\left\{ l_{3}\left(k_{0}\right),l_{4}\left(k_{0}\right)\right\} \\
l'_{4}\left(k_{0}\right) & \equiv & l_{4}\left(k_{0}\right)-\min\left\{ l_{3}\left(k_{0}\right),l_{4}\left(k_{0}\right)\right\} 
\end{eqnarray*}

\end_inset


\begin_inset Formula 
\[
l_{1}\left(k_{0}\right)+l'_{3}\left(k_{0}\right)=l_{2}\left(k_{0}\right)+l'_{4}\left(k_{0}\right)
\]

\end_inset

Dann wäre würde jedoch auch für 
\begin_inset Formula 
\begin{eqnarray*}
n'_{3} & \equiv & \prod_{k\in\mathbb{P}\backslash\left\{ k_{0}\right\} }p^{l_{3}\left(k\right)}_{k}\cdot p^{l'_{3}\left(k_{0}\right)}_{k\left(0\right)}\\
n'_{4} & \equiv & \prod_{k\in\mathbb{P}\backslash\left\{ k_{0}\right\} }p^{l_{4}\left(k\right)}_{k}\cdot p^{l'_{4}\left(k_{0}\right)}_{k\left(0\right)}
\end{eqnarray*}

\end_inset

gelten
\begin_inset Formula 
\[
n'_{3}\cdot n_{1}=n'_{4}\cdot n_{2}
\]

\end_inset

mit 
\begin_inset Formula $n_{3}'<n_{3}$
\end_inset

 und 
\begin_inset Formula $n'_{4}<n_{4}$
\end_inset

 wäre jedoch
\begin_inset Formula 
\[
\mbox{lcm}\left(n_{1},n_{2}\right)\leq n'_{3}\cdot n_{1}<n_{3}\cdot n_{1}
\]

\end_inset

Also muss gelten
\begin_inset Formula 
\begin{eqnarray*}
l_{3}\left(k\right) & = & \max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} -l_{1}\left(k\right)\\
l_{4}\left(k\right) & = & \max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} -l_{2}\left(k\right)
\end{eqnarray*}

\end_inset

Denn ist 
\begin_inset Formula $l_{3}\left(k\right)>0$
\end_inset

,
 dann muss gelten
\begin_inset Formula 
\[
\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} -l_{1}\left(k\right)>0
\]

\end_inset

oder aber
\begin_inset Formula 
\[
\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} >l_{1}\left(k\right)
\]

\end_inset

und somit 
\begin_inset Formula 
\[
l_{1}\left(k\right)<l_{2}\left(k\right)
\]

\end_inset

Also ist darum
\begin_inset Formula 
\[
l_{4}\left(k\right)=\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} -l_{2}\left(k\right)=l_{2}\left(k\right)-l_{2}\left(k\right)=0
\]

\end_inset

Ist jedoch 
\begin_inset Formula $l_{4}\left(k\right)>0$
\end_inset

,
 dann muss gelten
\begin_inset Formula 
\[
\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} -l_{2}\left(k\right)>0
\]

\end_inset

oder aber
\begin_inset Formula 
\[
\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} >l_{2}\left(k\right)
\]

\end_inset

und somit 
\begin_inset Formula 
\[
l_{2}\left(k\right)<l_{1}\left(k\right)
\]

\end_inset

Also ist darum
\begin_inset Formula 
\[
l_{3}\left(k\right)=\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} -l_{1}\left(k\right)=l_{2}\left(k\right)-l_{1}\left(k\right)=0
\]

\end_inset

Somit kann ich schreiben
\begin_inset Formula 
\begin{eqnarray*}
 &  & \mbox{lcm}\left(n_{1},n_{2}\right)\\
 & = & n_{3}\cdot n_{1}\\
 & = & \prod_{k\in\mathbb{P}}p^{l_{3}\left(k\right)+l_{1}\left(k\right)}_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{\left(\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} -l_{1}\left(k\right)\right)+l_{1}\left(k\right)}_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} -l_{2}\left(k\right)+l_{2}\left(k\right)}_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{\left(\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} -l_{2}\left(k\right)\right)+l_{2}\left(k\right)}_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{l_{4}\left(k\right)+l_{2}\left(k\right)}_{k}\\
 & = & n_{4}\cdot n_{2}
\end{eqnarray*}

\end_inset

Damit glaube ich jedoch,
 gezeigt zu haben,
 dass gilt
\begin_inset Formula 
\[
\mbox{lcm}\left(n_{1},n_{2}\right)=\prod_{k\in\mathbb{P}}p^{\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}
\]

\end_inset

Es sei nun 
\begin_inset Formula 
\[
\mbox{lcm}\left(n_{1},n_{2}\right)=\prod_{k\in\mathbb{P}}p^{l_{5}\left(k\right)}_{k}
\]

\end_inset

Gäbe es jetzt ein 
\begin_inset Formula $k_{1}\in\mathbb{N}$
\end_inset

 mit 
\begin_inset Formula $l_{5}\left(k_{1}\right)<\max\left\{ l_{1}\left(k_{1}\right),l_{2}\left(k_{1}\right)\right\} $
\end_inset

 dann müsste mit
\begin_inset Formula 
\[
\prod_{k\in\mathbb{P}}p^{l_{5}\left(k\right)}_{k}=\prod_{k\in\mathbb{P}}p^{l_{3}\left(k\right)+l_{1}\left(k\right)}_{k}=\prod_{k\in\mathbb{P}}p^{l_{4}\left(k\right)+l_{2}\left(k\right)}_{k}
\]

\end_inset

gelten:
\begin_inset Formula 
\[
l_{5}\left(k_{1}\right)=l_{3}\left(k_{1}\right)+l_{1}\left(k_{1}\right)=l_{4}\left(k_{1}\right)+l_{2}\left(k_{1}\right)
\]

\end_inset

Es sei nun 
\begin_inset Formula 
\[
l_{1}\left(k_{1}\right)=\max\left\{ l_{1}\left(k_{1}\right),l_{2}\left(k_{1}\right)\right\} 
\]

\end_inset

Also müsste gelten
\begin_inset Formula 
\[
l_{5}\left(k_{1}\right)<l_{1}\left(k_{1}\right)
\]

\end_inset

und somit 
\begin_inset Formula 
\[
l_{3}\left(k_{1}\right)=l_{5}\left(k_{1}\right)-l_{1}\left(k_{1}\right)<0
\]

\end_inset

was jedoch ein Widerspruch wäre zu 
\begin_inset Formula $l_{3}\left(k\right)\geq0$
\end_inset

.
 Wäre jedoch 
\begin_inset Formula 
\[
l_{2}\left(k_{1}\right)=\max\left\{ l_{1}\left(k_{1}\right),l_{2}\left(k_{1}\right)\right\} 
\]

\end_inset

dann müsste gelten
\begin_inset Formula 
\[
l_{5}\left(k_{1}\right)=l_{4}\left(k_{1}\right)+l_{2}\left(k_{1}\right)
\]

\end_inset

und also mit 
\begin_inset Formula 
\[
l_{5}\left(k_{1}\right)<l_{2}\left(k_{1}\right)
\]

\end_inset

entsprechend
\begin_inset Formula 
\[
l_{5}\left(k_{1}\right)-l_{2}\left(k_{1}\right)<0
\]

\end_inset

also 
\begin_inset Formula 
\[
l_{4}\left(k_{1}\right)=l_{5}\left(k_{1}\right)-l_{2}\left(k_{1}\right)<0
\]

\end_inset

was jedoch ein Widerspruch wäre zu
\begin_inset Formula 
\[
l_{4}\left(k_{1}\right)\geq0
\]

\end_inset

Somit muss wirklich gelten
\begin_inset Formula 
\[
\forall k\in\mathbb{N}:\,l_{4}\left(k_{1}\right)\geq\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} 
\]

\end_inset

Damit glaube ich,
 den Beweis wirklich erbracht zu haben.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
Ich möchte einen vorbereitenden Satz formulieren und beweisen:
\end_layout

\begin_layout Proposition
Es seien 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

.
 Dann muss gelten
\begin_inset Formula 
\[
\min\left\{ n_{1},n_{2}\right\} +\max\left\{ n_{1},n_{2}\right\} =n_{1}+n_{2}
\]

\end_inset


\end_layout

\begin_layout Proof
Es sei 
\begin_inset Formula $n_{1}\leq n_{2}$
\end_inset

.
 Also ist 
\begin_inset Formula 
\begin{eqnarray*}
\min\left\{ n_{1},n_{2}\right\}  & = & n_{1}\\
\max\left\{ n_{1},n_{2}\right\}  & = & n_{2}
\end{eqnarray*}

\end_inset

Also gilt
\begin_inset Formula 
\[
\min\left\{ n_{1},n_{2}\right\} +\max\left\{ n_{1},n_{2}\right\} =n_{1}+n_{2}
\]

\end_inset

Ist jedoch 
\begin_inset Formula $n_{1}>n_{2}$
\end_inset

,
 dann ist 
\begin_inset Formula 
\begin{eqnarray*}
\min\left\{ n_{1},n_{2}\right\}  & = & n_{2}\\
\max\left\{ n_{1},n_{2}\right\}  & = & n_{1}
\end{eqnarray*}

\end_inset

Also gilt
\begin_inset Formula 
\[
\min\left\{ n_{1},n_{2}\right\} +\max\left\{ n_{1},n_{2}\right\} =n_{2}+n_{1}=n_{1}+n_{2}
\]

\end_inset

Somit kann ich in jedem Fall schreiben,
 dass gelten muss:
\begin_inset Formula 
\[
\min\left\{ n_{1},n_{2}\right\} +\max\left\{ n_{1},n_{2}\right\} =n_{1}+n_{2}
\]

\end_inset

Somit glaube ich,
 gezeigt zu haben,
 dass der Beweis erbracht ist.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
Nun gibt es einen einfachen Zusammenhang vom dem größten gemeinsamen Teiler und kleinsten gemeinsamen Vielfachen von zwei Zahlen.
 Es gilt:
\end_layout

\begin_layout Proposition
Es seien 
\begin_inset Formula $n_{1},n_{2}\in\mathbb{N}$
\end_inset

.
 Dann muss gelten
\begin_inset Formula 
\[
\gcd\left(n_{1},n_{2}\right)\cdot\mbox{lcm}\left(n_{1},n_{2}\right)=n_{1}\cdot n_{2}
\]

\end_inset


\end_layout

\begin_layout Proof
Es seien 
\begin_inset Formula $n_{1},\,n_{2}\in\mathbb{N}$
\end_inset

 sowie
\begin_inset Formula 
\[
n_{1}=\prod_{k\in\mathbb{P}}p^{l_{1}\left(k\right)}_{k},\,n_{2}=\prod_{k\in\mathbb{P}}p^{l_{2}\left(k\right)}_{k}
\]

\end_inset

mit 
\begin_inset Formula 
\[
p_{k}\in\mathbb{P}\equiv\mbox{Menge der Primzahlen}
\]

\end_inset

sowie 
\begin_inset Formula 
\[
l_{1}\left(k\right),l_{2}\left(k\right)\in\mathbb{N}_{0}
\]

\end_inset

Dann gilt 
\begin_inset Formula 
\begin{eqnarray*}
\gcd\left(n_{1,}n_{2}\right) & = & \prod_{k\in\mathbb{P}}p^{\min\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}\\
\mbox{lcm}\left(n_{1,}n_{2}\right) & = & \prod_{k\in\mathbb{P}}p^{\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}
\end{eqnarray*}

\end_inset

Also kann ich schreiben
\begin_inset Formula 
\begin{eqnarray*}
 &  & \gcd\left(n_{1,}n_{2}\right)\cdot\mbox{lcm}\left(n_{1,}n_{2}\right)\\
 & = & \prod_{k\in\mathbb{P}}p^{\min\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}\cdot\prod_{k\in\mathbb{P}}p^{\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{\min\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} +\max\left\{ l_{1}\left(k\right),l_{2}\left(k\right)\right\} }_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{l_{1}\left(k\right)+l_{2}\left(k\right)}_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{l_{1}\left(k\right)}_{k}\cdot p^{l_{2}\left(k\right)}_{k}\\
 & = & \prod_{k\in\mathbb{P}}p^{l_{1}\left(k\right)}_{k}\cdot\prod_{k\in\mathbb{P}}p^{l_{2}\left(k\right)}_{k}\\
 & = & n_{1}\cdot n_{2}
\end{eqnarray*}

\end_inset

Damit hoffe ich,
 gezeigt zu haben,
 dass der Beweis erbracht ist.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Exercise
Der Aktienkurs eines bestimmten Titels falle um 
\begin_inset Formula $a\%$
\end_inset

.
 Um wie viele Prozent 
\begin_inset Formula $b$
\end_inset

 des neuen Aktienkurs muss er anschließend wieder steigen,
 damit er schlussendlich wieder auf dem ursprünglichen Stand ist?
 Wie groß ist das Verhältnis 
\begin_inset Formula 
\[
\frac{b}{a}
\]

\end_inset

Der erste Versuch war schon mal nicht erfolgreich.
 Der ursprünglich Aktienkurs sei 
\begin_inset Formula $t_{1}$
\end_inset

.
 Zwar ist es nicht nötig,
 diesen einzuführen.
 Aber dies erleichtert mir die Anschauung.
 Es sei 
\begin_inset Formula $k\in\mathbb{N}$
\end_inset

 und der Aktienkurs falle um 
\begin_inset Formula 
\[
a=\frac{k-1}{k}\cdot100
\]

\end_inset

Prozent.
 Ist also etwa 
\begin_inset Formula $k=4$
\end_inset

 dann ist 
\begin_inset Formula 
\[
\frac{4-1}{4}\cdot100=\frac{3}{4}\cdot100=75
\]

\end_inset

Prozent.
 Dann ist der neue Aktienkurs
\begin_inset Formula 
\[
1-\frac{k-1}{k}=\frac{k-\left(k-1\right)}{k}=\frac{k-k+1}{k}=\frac{1}{k}
\]

\end_inset

Prozent des alten Aktienkurses.
 Für das Beispiel 
\begin_inset Formula $k=4$
\end_inset

 ist dann 
\begin_inset Formula 
\[
\frac{1}{4}\cdot100=25
\]

\end_inset

Prozent des alten Aktienkurs.
 Also beträgt der neue Aktienkurs
\begin_inset Formula 
\[
t_{1}=\frac{1}{k}\cdot t_{0}
\]

\end_inset

Nun ist derjenige Prozentsatz 
\begin_inset Formula $b$
\end_inset

 von 
\begin_inset Formula $t_{1}$
\end_inset

 derart zu bestimmen,
 so dass gilt:
\begin_inset Formula 
\[
t_{1}+\frac{b}{100}\cdot t_{1}=t_{0}
\]

\end_inset

Also muss gelten
\begin_inset Formula 
\[
\frac{b}{100}\cdot t_{1}=t_{0}-t_{1}
\]

\end_inset

und somit 
\begin_inset Formula 
\begin{eqnarray*}
 &  & b\\
 & = & \frac{t_{0}-t_{1}}{t_{1}}\cdot100\\
 & = & \frac{t_{0}-\frac{t_{0}}{k}}{\frac{t_{0}}{k}}\cdot100\\
 & = & \frac{1-\frac{1}{k}}{\frac{1}{k}}\cdot100\\
 & = & \frac{\frac{k-1}{k}}{\frac{1}{k}}\cdot100\\
 & = & \left(k-1\right)\cdot100
\end{eqnarray*}

\end_inset

Im Beispiel 
\begin_inset Formula $k=4$
\end_inset

 muss also gelten
\begin_inset Formula 
\[
b=400
\]

\end_inset

also muss gelten
\begin_inset Formula 
\[
\frac{b}{a}=\frac{\left(k-1\right)\cdot100}{\frac{k-1}{k}\cdot100}=k
\]

\end_inset

Und nun endlich zum allgemeinen Fall:
 Der ursprüngliche Aktienkurs sei 
\begin_inset Formula $t_{0}$
\end_inset

.
 Er falle um 
\begin_inset Formula $a$
\end_inset

 Prozent.
 Also sei 
\begin_inset Formula 
\begin{eqnarray*}
 &  & t_{1}\\
 & = & t_{0}-\frac{a}{100}\cdot t_{0}\\
 & = & \left(1-\frac{a}{100}\right)\cdot t_{0}
\end{eqnarray*}

\end_inset

Nachher ist der Prozentsatz 
\begin_inset Formula $b$
\end_inset

 von 
\begin_inset Formula $t_{1}$
\end_inset

 derart zu bestimmen,
 so dass gilt
\begin_inset Formula 
\[
t_{1}+\frac{b}{100}\cdot t_{1}=t_{0}
\]

\end_inset

Es ist also 
\begin_inset Formula 
\[
\frac{b}{100}\cdot t_{1}=t_{0}-t_{1}
\]

\end_inset

und somit
\begin_inset Formula 
\[
\frac{b}{100}=\frac{t_{0}-t_{1}}{t_{1}}
\]

\end_inset

und auch
\begin_inset Formula 
\begin{eqnarray*}
 &  & b\\
 & = & \frac{t_{0}-t_{1}}{t_{1}}\cdot100\\
 & = & \frac{t_{0}-\left(1-\frac{a}{100}\right)\cdot t_{0}}{\left(1-\frac{a}{100}\right)\cdot t_{0}}\cdot100\\
 & = & \frac{\left(1-\left(1-\frac{a}{100}\right)\right)\cdot t_{0}}{\left(1-\frac{a}{100}\right)\cdot t_{0}}\cdot100\\
 & = & \frac{1-\left(1-\frac{a}{100}\right)}{1-\frac{a}{100}}\cdot100\\
 & = & \frac{1-1+\frac{a}{100}}{1-\frac{a}{100}}\cdot100\\
 & = & \frac{\frac{a}{100}}{1-\frac{a}{100}}\cdot100\\
 & = & \frac{\frac{a}{100}\cdot100}{\left(1-\frac{a}{100}\right)\cdot100}\cdot100\\
 & = & \frac{a}{\left(1-\frac{a}{100}\right)\cdot100}\cdot100\\
 & = & \frac{a}{1-\frac{a}{100}}
\end{eqnarray*}

\end_inset

Also muss gelten
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{b}{a}\\
 & = & \frac{\frac{a}{1-\frac{a}{100}}}{a}\\
 & = & \frac{\frac{a}{1-\frac{a}{100}}}{a}\\
 & = & \frac{\frac{a}{1-\frac{a}{100}}\cdot\left(1-\frac{a}{100}\right)}{a\cdot\left(1-\frac{a}{100}\right)}\\
 & = & \frac{a}{a\cdot\left(1-\frac{a}{100}\right)}\\
 & = & \frac{1}{1-\frac{a}{100}}
\end{eqnarray*}

\end_inset

Wenn 
\begin_inset Formula $a=\frac{k-1}{k}\cdot100$
\end_inset

 ist,
 dann gilt:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \frac{b}{a}\\
 & = & \frac{1}{1-\frac{\frac{k-1}{k}\cdot100}{100}}\\
 & = & \frac{1}{1-\frac{k-1}{k}}\\
 & = & \frac{1}{\frac{k-\left(k-1\right)}{k}}\\
 & = & \frac{k}{k-\left(k-1\right)}\\
 & = & \frac{k}{k-k+1}\\
 & = & k
\end{eqnarray*}

\end_inset

womit ich meine,
 gezeigt zu haben,
 dass das Resultat nicht ganz falsch sein kann.
\end_layout

\begin_layout Chapter
Konjunktive und disjunktive Normalformen von Aussagen
