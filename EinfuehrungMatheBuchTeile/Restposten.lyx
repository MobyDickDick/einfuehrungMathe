\begin_layout Chapter
Abschätzung des Quotienten zweier Potenzreihen
\end_layout

\begin_layout Standard
Ich habe zwei Potenzreihen 
\begin_inset Formula $f(x)$
\end_inset

 sowie 
\begin_inset Formula $g(x)$
\end_inset

 welche für alle nicht\SpecialChar nobreakdash
negativen reellen Zahlen definiert sei.
 Es gelte also:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
f(x)={\displaystyle \sum_{k\in\mathbb{N}}a_{k}\cdot x^{k}}
\]

\end_inset


\end_layout

\begin_layout Standard
respektive 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
g(x)={\displaystyle \sum_{k\in\mathbb{N}}b_{k}\cdot x^{k}}
\]

\end_inset


\end_layout

\begin_layout Standard
wobei alle 
\begin_inset Formula $a_{k}$
\end_inset

,
 
\begin_inset Formula $b_{k}\in\mathbb{R}$
\end_inset

 seien für 
\begin_inset Formula $k\in\mathbb{N}_{0}$
\end_inset

.
 Weiter sei 
\begin_inset Formula 
\[
\lim_{k\rightarrow\infty}\frac{a_{k}}{b_{k}}=c\in\mathbb{R}
\]

\end_inset


\end_layout

\begin_layout Standard
und 
\begin_inset Formula $g(x)\neq0$
\end_inset

 für genügend große x.
\end_layout

\begin_layout Standard
Dann ist 
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\frac{f(x)}{g(x)}=c
\]

\end_inset


\end_layout

\begin_layout Standard

\series bold
Beweis:
\end_layout

\begin_layout Standard
Es sei 
\begin_inset Formula $\epsilon\in\mathbb{R}$
\end_inset

.
 Dann gilt nach Voraussetzung:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\exists n_{0}\in\mathbb{R}\,\forall n\in\mathbb{N}\:n>n_{0}\,\left|\frac{a_{n}}{b_{n}}-c\right|<\frac{\epsilon}{3}\label{eq:konvergenteQuotientnenfolge.}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Es sei jetzt 
\begin_inset Formula $n\in\mathbb{N}$
\end_inset

 mit 
\begin_inset Formula $n>n_{0}$
\end_inset

.
 Dann gilt für dieses n die obige Aussage.
 Da nun 
\begin_inset Formula 
\[
\frac{a_{n}}{b_{n}}-c\in\mathbb{R}
\]

\end_inset

 liegt,
 muss 
\begin_inset Formula $b_{n}$
\end_inset

 ebenfalls eine reelle Zahl sein.
 Bestimme nun 
\begin_inset Formula $x_{0}\in\mathbb{R}$
\end_inset

 derart,
 dass 
\begin_inset Formula 
\begin{equation}
\left|\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}-\frac{a_{n}}{b_{n}}\right|<\frac{\epsilon}{3}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
ist für alle 
\begin_inset Formula $x>x_{0}$
\end_inset

.
 Auch dies ist möglich,
 denn aus 
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\sum^{n}_{k=0}a_{k}\cdot x^{n-k}=a_{n}
\]

\end_inset

 sowie 
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\sum^{n}_{k=0}b_{n}\cdot x^{n-k}=b_{n}
\]

\end_inset


\end_layout

\begin_layout Standard
folgt aus Satz 42.1 des Buchs von Heuser
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}=\frac{a_{n}}{b_{n}}
\]

\end_inset


\end_layout

\begin_layout Standard
Dies bedeutet,
 dass es ein solches 
\begin_inset Formula $x_{0}$
\end_inset

 mit der gewünschten Eigenschaft geben muss.
 es sei nun 
\begin_inset Formula $x>x_{0}$
\end_inset

.
 Entsprechend ist nun 
\begin_inset Formula 
\[
\left|\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}-\frac{a_{n}}{b_{n}}\right|=\left|\frac{\sum^{n}_{k=0}a_{k}\cdot x^{k}}{\sum^{n}_{k=0}b_{k}\cdot x^{k}}-\frac{a_{n}}{b_{n}}\right|<\frac{\epsilon}{3}
\]

\end_inset


\end_layout

\begin_layout Standard
Bestimme zuletzt ein 
\begin_inset Formula $n_{1}>n_{0}$
\end_inset

 mit 
\begin_inset Formula 
\[
\left|\frac{\sum^{n}_{k=0}a_{k}\cdot x^{k}}{\sum^{n}_{k=0}b_{k}\cdot x^{k}}-\frac{f(x)}{g(x)}\right|<\frac{\epsilon}{3}
\]

\end_inset


\end_layout

\begin_layout Standard
Dieses 
\begin_inset Formula $n_{1}$
\end_inset

 muss vorhanden sein,
 denn mit 
\begin_inset Formula $\lim_{n\rightarrow\infty}\sum^{n}_{k=0}a_{k}\cdot x^{k}=f(x)$
\end_inset

 und 
\begin_inset Formula $\lim_{n\rightarrow\infty}\sum^{n}_{k=0}a_{k}\cdot x^{k}=g(x)\neq0$
\end_inset

 für genügend große 
\begin_inset Formula $x\in\mathbb{R}$
\end_inset

 gilt nach dem Divisionssatz für Folgen 
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\frac{\sum^{n}_{k=0}a_{k}\cdot x^{k}}{\sum^{n}_{k=0}b_{k}\cdot x^{k}}=\frac{f(x)}{g(x)}
\]

\end_inset


\end_layout

\begin_layout Standard
Daraus folgt die Behauptung.
 Nun ist also für genügend große x und n
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
\left|\frac{f(x)}{g(x)}-c\right| & = & \left|\frac{f(x)}{g(x)}-\frac{\sum^{n}_{k=0}a_{k}\cdot x^{k}}{\sum^{n}_{k=0}b_{k}\cdot x^{k}}+\frac{\sum^{n}_{k=0}a_{k}\cdot x^{k}}{\sum^{n}_{k=0}b_{k}\cdot x^{k}}-c\right|\\
 & \leq & \left|\frac{f(x)}{g(x)}-\frac{\sum^{n}_{k=0}a_{k}\cdot x^{k}}{\sum^{n}_{k=0}b_{k}\cdot x^{k}}\right|+\left|\frac{\sum^{n}_{k=0}a_{k}\cdot x^{k}}{\sum^{n}_{k=0}b_{k}\cdot x^{k}}-c\right|\\
 & < & \frac{\epsilon}{3}+\left|\frac{\sum^{n}_{k=0}a_{k}\cdot x^{k}}{\sum^{n}_{k=0}b_{k}\cdot x^{k}}-c\right|\\
 & < & \frac{\epsilon}{3}+\left|\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}-\frac{a_{n}}{b_{n}}+\frac{a_{n}}{b_{n}}-c\right|\\
 & \leq & \frac{\epsilon}{3}+\left|\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}-\frac{a_{n}}{b_{n}}\right|+\left|\frac{a_{n}}{b_{n}}-c\right|\\
 & < & \frac{\epsilon}{3}+\frac{\epsilon}{3}+\frac{\epsilon}{3}=\epsilon
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
Dies bedeutet jedoch gerade
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\frac{f(x)}{g(x)}=c
\]

\end_inset


\end_layout

\begin_layout Standard
Damit ist der Beweis geführt.
\end_layout

\begin_layout Standard
Falls nun 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lim_{k\rightarrow\infty}\frac{a_{k}}{b_{k}}=\infty
\]

\end_inset


\end_layout

\begin_layout Standard
ist,
 dann ist zu zeigen,
 dass
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\frac{f(x)}{g(x)}=\infty
\]

\end_inset


\end_layout

\begin_layout Standard
gilt.
\end_layout

\begin_layout Standard

\series bold
Beweis:
\end_layout

\begin_layout Standard
Es sei nun
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lim_{k\rightarrow\infty}\frac{a_{k}}{b_{k}}=\infty
\]

\end_inset


\end_layout

\begin_layout Standard
Dies bedeutet,
 dass für alle 
\begin_inset Formula $\epsilon\in\mathbb{R}^{+}$
\end_inset

ein 
\begin_inset Formula $n_{0}\in\mathbb{N}$
\end_inset

 gibt,
 so dass für alle 
\begin_inset Formula $n\in\mathbb{N}$
\end_inset

 mit 
\begin_inset Formula $n>n_{0}$
\end_inset

 gilt
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{a_{n}}{b_{n}}>\frac{3}{\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
Nun sei also 
\begin_inset Formula $n>n_{0}$
\end_inset

mit 
\begin_inset Formula 
\[
\frac{a_{n}}{b_{n}}>\frac{3}{\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
Nun kann 
\begin_inset Formula $b_{n}=0$
\end_inset

 sein.
 Ist dies der Fall,
 dann kann 
\begin_inset Formula $a_{n}$
\end_inset

 nicht auch gleich Null sein,
 denn ansonsten wäre Wert des Bruch endgültig nicht mehr bestimmt.
 Also muss 
\begin_inset Formula $a_{n}>0$
\end_inset

 sein.
 Bestimme nun ein 
\begin_inset Formula $x_{0}$
\end_inset

 mit 
\begin_inset Formula 
\[
\frac{a_{n}}{b_{n}}-\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}>\frac{2}{\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
Dieses 
\begin_inset Formula $x_{0}$
\end_inset

 muss existieren,
 denn 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\sum^{n}_{k=0}a_{k}\cdot x^{n-k}=a_{n}
\]

\end_inset

 respektive
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\sum^{n}_{k=0}b_{k}\cdot x^{n-k}=b_{n}
\]

\end_inset


\end_layout

\begin_layout Standard
also existiert nach dem Satz 42.1 vom Heuser ein 
\begin_inset Formula $x_{0}$
\end_inset

 mit der gewünschten Eigenschaft.
\end_layout

\begin_layout Standard
Nun sei also 
\begin_inset Formula $x\in\mathbb{R}$
\end_inset

 mit 
\begin_inset Formula $x>x_{0}$
\end_inset

 mit der gewünschten Eingenschaft
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{a_{n}}{b_{n}}-\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}>\frac{2}{\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
Bestimme nun ein 
\begin_inset Formula $n_{1}\in\mathbb{N}$
\end_inset

 mit 
\begin_inset Formula $n_{1}>n_{0}$
\end_inset

 und der Eigenschaft dass 
\begin_inset Formula $\forall n\in\mathbb{N}$
\end_inset

 mit 
\begin_inset Formula $n>n_{0}$
\end_inset

 gilt 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{f(x)}{g(x)}-\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}<\frac{1}{\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
Nun sei also 
\begin_inset Formula $n>n_{0}$
\end_inset

 und darum
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{f(x)}{g(x)}-\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}>-\frac{1}{\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
Dann ist insgesamt
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
\frac{f(x)}{g(x)} & = & \Bigm(\frac{f(x)}{g(x)}-\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}\Bigm)+\Bigm(\frac{\sum^{n}_{k=0}a_{k}\cdot x^{n-k}}{\sum^{n}_{k=0}b_{k}\cdot x^{n-k}}-\frac{a_{n}}{b_{n}}\Bigm)\\
 & > & \frac{2}{\epsilon}-\frac{1}{\epsilon}=\frac{1}{\epsilon}
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
Das bedeutet jedoch,
 dass 
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\frac{f(x)}{g(x)}=\infty
\]

\end_inset


\end_layout

\begin_layout Standard
ist,
 wobei der Beweis erbracht wurde.
\end_layout

\begin_layout Standard
Falls 
\begin_inset Formula 
\[
\lim_{k\rightarrow\infty}\frac{a_{k}}{b_{k}}=-\infty
\]

\end_inset


\end_layout

\begin_layout Standard
dann ist zu zeigen,
 dass ebenfalls 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\frac{f(x)}{g(x)}=-\infty
\]

\end_inset


\end_layout

\begin_layout Standard
ist.
 
\end_layout

\begin_layout Standard

\series bold
Beweis:
\end_layout

\begin_layout Standard
Da also nach Voraussetzung 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lim_{k\rightarrow\infty}\frac{a_{k}}{b_{k}}=-\infty
\]

\end_inset


\end_layout

\begin_layout Standard
ist,
 gibt es nach für alle 
\begin_inset Formula $\epsilon\in\mathbb{R}^{+}$
\end_inset

 ein 
\begin_inset Formula $n_{0}\in\mathbb{N}$
\end_inset

,
 so dass 
\begin_inset Formula $\forall n\in\mathbb{N}$
\end_inset

,
 für welche 
\begin_inset Formula $n>n_{0}$
\end_inset

ist,
\begin_inset Formula 
\[
\frac{a_{k}}{b_{k}}<-\frac{3}{\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
Da 
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\sum^{n}_{k=0}a_{k}\cdot x^{n-k}=a_{n}
\]

\end_inset


\end_layout

\begin_layout Standard
sowie 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lim_{x\rightarrow\infty}\sum^{n}_{k=0}b_{k}\cdot x^{n-k}=b_{n}
\]

\end_inset


\end_layout

\begin_layout Chapter
Größter Gemeinsamer Teiler
\end_layout

\begin_layout Standard
Der größte gemeinsame Teiler geht auf die Zeit zurück,
 in welcher das Rechnen von Hand ausgeführt wurde.
 Denn das Bruchrechnen von Zahlen der Form 
\begin_inset Formula 
\[
q\equiv\frac{z}{n}
\]

\end_inset

wobei 
\begin_inset Formula $z\in\mathbb{Z}$
\end_inset

 und 
\begin_inset Formula $n\in\mathbb{N}$
\end_inset

 sei,
 ist einfacher,
 falls angenommen wird,
 dass der Zähler (mit der Bezeichnung 
\begin_inset Formula $z$
\end_inset

) und der Nenner (mit der Bezeichnung 
\begin_inset Formula $n$
\end_inset

) keine gemeinsamen Teiler mehr besitzen.
 Sind also zwei ganze Zahlen 
\begin_inset Formula 
\[
z_{1},z_{2}\in\mathbb{Z}
\]

\end_inset

gegeben,
 wobei ich annehmen kann,
 dass weder 
\begin_inset Formula $z_{1}$
\end_inset

 noch 
\begin_inset Formula $z_{2}$
\end_inset

 den Wert 
\begin_inset Formula $0$
\end_inset

 besitzen,
 dann heiße 
\begin_inset Formula $t\in\mathbb{N}\backslash\left\{ 1\right\} $
\end_inset

 ein gemeinsamer Teiler von 
\begin_inset Formula $z_{1}$
\end_inset

 und 
\begin_inset Formula $z_{2}$
\end_inset

 sei,
 falls gilt
\begin_inset Formula 
\[
\frac{\left|z_{1}\right|}{t}\in\mathbb{N}\wedge\frac{\left|z_{2}\right|}{t}\in\mathbb{N}
\]

\end_inset

Ich mache ein Beispiel:
 Es seien 
\begin_inset Formula $z_{1}=-48$
\end_inset

 und 
\begin_inset Formula $z_{2}=18$
\end_inset

.
 Also ist 
\begin_inset Formula 
\[
t=2
\]

\end_inset

ein gemeinsamer Teiler von 
\begin_inset Formula $z_{1}$
\end_inset

 und 
\begin_inset Formula $z_{2}$
\end_inset

.
 Denn es ist 
\begin_inset Formula 
\[
\frac{\left|-48\right|}{2}=\frac{48}{2}=24\in\mathbb{N}
\]

\end_inset

wie auch 
\begin_inset Formula 
\[
\frac{18}{2}=9\in\mathbb{N}
\]

\end_inset

Jedoch ist 
\begin_inset Formula $12$
\end_inset

 kein gemeinsamer Teiler von 
\begin_inset Formula $-48$
\end_inset

 und 
\begin_inset Formula $18$
\end_inset

.
 Denn es ist zwar
\begin_inset Formula 
\[
\frac{\left|-48\right|}{12}=4\in\mathbb{N}
\]

\end_inset

jedoch
\begin_inset Formula 
\[
\frac{18}{12}=\frac{3}{2}\in\mathbb{Q}\backslash\mathbb{N}
\]

\end_inset

Und um zu zeigen,
 wie größte gemeinsame Teiler das Rechnen mit Bruchzahlen vereinfachen sollen,
 sei an der Rechnung 
\begin_inset Formula 
\[
\frac{145}{45}-\frac{21}{15}
\]

\end_inset

demonstriert.
 Ich kann zwar die Rechnung machen in dem ich sie umschreibe in 
\begin_inset Formula 
\[
\frac{145}{45}-\frac{21}{15}=\frac{145\cdot15}{45\cdot15}-\frac{21\cdot45}{15\cdot45}
\]

\end_inset

Anschließend benutze ich die Eigenschaft,
 dass die Multiplikation kommutativ ist.
 Es gilt also
\begin_inset Formula 
\[
45\cdot15=15\cdot45
\]

\end_inset

und somit 
\begin_inset Formula 
\[
