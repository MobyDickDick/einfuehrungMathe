\begin_layout Section
Implikation aus Äquivalenz
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung an den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:Implikation-Implikation-aus-Aequivalenz"
nolink "false"

\end_inset

:
 Es seien 
\begin_inset Formula $A,B$
\end_inset

 Metasymbolen von Aussagen,
 welche in sich selbst und in Bezug auf die anderen Symbolen des Satzes widerspruchsfrei seien.
 Dann gilt:
\begin_inset Formula 
\[
\left(A\Leftrightarrow B\right)\Rightarrow\left(A\Rightarrow B\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Ich möchte den Beweis wiederum mit Hilfe der Deltanotation erbringen.
 Ich möchte zeigen:
\begin_inset Formula 
\[
\delta\left(A\Leftrightarrow B\right)\leq\delta\left(A\Rightarrow B\right)
\]

\end_inset

Es ist 
\begin_inset Formula 
\begin{align*}
 & \delta\left(A\Leftrightarrow B\right)\\
= & 1-\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\\
= & 1-\left(\delta^{2}\left(A\right)-2\cdot\delta\left(A\right)\cdot\delta\left(B\right)+\delta^{2}\left(B\right)\right)
\end{align*}

\end_inset

Nun wende ich den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Idempotenz"
nolink "false"

\end_inset

 der Idempotenz der Deltanotation und erhalte
\begin_inset Formula 
\begin{align*}
 & \delta\left(A\Leftrightarrow B\right)\\
= & 1-\left(\delta^{2}\left(A\right)-2\cdot\delta\left(A\right)\cdot\delta\left(B\right)+\delta^{2}\left(B\right)\right)\\
= & 1-\left(\delta\left(A\right)-2\cdot\delta\left(A\right)\cdot\delta\left(B\right)+\delta\left(B\right)\right)\\
= & 1-\delta\left(A\right)+2\cdot\delta\left(A\right)\cdot\delta\left(B\right)-\delta\left(B\right)
\end{align*}

\end_inset

Wohingegen gilt:
\begin_inset Formula 
\begin{align*}
 & \delta\left(A\Rightarrow B\right)\\
= & 1-\delta\left(A\right)\cdot\left(1-\delta\left(B\right)\right)\\
= & 1-\left(\delta\left(A\right)\cdot1-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 1-\left(\delta\left(A\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
= & 1-\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)
\end{align*}

\end_inset

Also möchte ich die Differenz 
\begin_inset Formula 
\[
\delta\left(A\Rightarrow B\right)-\delta\left(A\Leftrightarrow B\right)
\]

\end_inset

berechnen.
 Ich erhalte
\begin_inset Formula 
\begin{align*}
 & \delta\left(A\Rightarrow B\right)-\delta\left(A\Leftrightarrow B\right)\\
= & 1-\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-\\
 & \left(1-\delta\left(A\right)+2\cdot\delta\left(A\right)\cdot\delta\left(B\right)-\delta\left(B\right)\right)\\
= & 1-\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-1+\\
 & \delta\left(A\right)-2\cdot\delta\left(A\right)\cdot\delta\left(B\right)+\delta\left(B\right)\\
= & 1-1+\delta\left(A\right)-\delta\left(A\right)+\delta\left(B\right)+\\
 & \delta\left(A\right)\cdot\delta\left(B\right)-2\cdot\delta\left(A\right)\cdot\delta\left(B\right)\\
= & 0+0+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
= & \delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)
\end{align*}

\end_inset

Mit 
\begin_inset Formula $0\leq\delta\left(A\right)\leq1$
\end_inset

 ist
\begin_inset Formula 
\begin{align*}
-0 & =0\geq-\delta\left(A\right)\geq-1
\end{align*}

\end_inset

und darum auch
\begin_inset Formula 
\[
1-0=1\geq1-\delta\left(A\right)\geq1-1=0
\]

\end_inset

Somit ist ist insbesondere
\begin_inset Formula 
\[
1-\delta\left(A\right)\geq0
\]

\end_inset

und darum auch
\begin_inset Formula 
\[
\delta\left(A\Rightarrow B\right)-\delta\left(A\Leftrightarrow B\right)=\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)\geq0\cdot0=0
\]

\end_inset

Darum muss gelten
\begin_inset Formula 
\[
\delta\left(A\Rightarrow B\right)\geq\delta\left(A\Leftrightarrow B\right)
\]

\end_inset

oder eben
\begin_inset Formula 
\[
\delta\left(A\Leftrightarrow B\right)\leq\delta\left(A\Rightarrow B\right)
\]

\end_inset

Darum glaube ich,
 schließen zu können,
 dass gelten muss
\begin_inset Formula 
\[
\left(A\Leftrightarrow B\right)\Rightarrow\left(A\Rightarrow B\right)
\]

\end_inset


\end_layout

\begin_layout Section
Satz der Implikation aus einer Aussage
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung an den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:Implikation-Disjunktion-aus-Aussage"
nolink "false"

\end_inset

:
 Es seien 
\begin_inset Formula $A$
\end_inset

 und 
\begin_inset Formula $B$
\end_inset

 Metasymbole von Aussagen,
 welche in sich und in Bezug auf die anderen Symbolen des Satzes widerspruchsfrei seien.
 Dann gilt:
\begin_inset Formula 
\[
A\Rightarrow\left(A\vee B\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Ich möchte zuerst einen eleganteren Beweis versuchen.
 Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Implikation"
nolink "false"

\end_inset

 der Deltanotation der Implikation kann ich schreiben 
\begin_inset Formula 
\begin{equation}
\delta\left(A\vee B\right)=\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\label{eq:61}
\end{equation}

\end_inset

Aufgrund des Distributivgesetzes der ganzen Zahlen kann ich schreiben:
\begin_inset Formula 
\[
\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)=\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)
\]

\end_inset

Dieses Teilresultat schreibe ich in die vorhergehende Gleichung und erhalte
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\vee B\right)\\
 & = & \delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & \delta\left(A\right)+\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)
\end{eqnarray*}

\end_inset

Da die Gleichheit von ganzen Zahlen transitiv ist,
 kann ich verkürzt schreiben:
\begin_inset Formula 
\[
\delta\left(A\vee B\right)=\delta\left(A\right)+\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)
\]

\end_inset

Nun möchte ich banalerweise zeigen,
 dass
\begin_inset Formula 
\[
\delta\left(B\right)\cdot\left(1-\delta\left(A\right)\right)\geq0
\]

\end_inset

ist.
 Es gilt aufgrund der Definition 
\begin_inset CommandInset ref
LatexCommand ref
reference "def:delta-Kronecker-Symbol"
nolink "false"

\end_inset

 des Deltasymbols von Kronecker:
 
\begin_inset Formula 
\[
0\leq\delta\left(B\right)\leq1
\]

\end_inset

und 
\begin_inset Formula 
\[
0\leq\delta\left(A\right)\leq1
\]

\end_inset

Somit gilt auch
\begin_inset Formula 
\[
-0=0\geq-\delta\left(A\right)\geq-1
\]

\end_inset

oder auch
\begin_inset Formula 
\[
-1\leq-\delta\left(A\right)\leq0
\]

\end_inset

und auch 
\begin_inset Formula 
\[
1-1=0\leq1-\delta\left(A\right)\leq1-0=0
\]

\end_inset

das bedeutet
\begin_inset Formula 
\[
0\leq1-\delta\left(A\right)\leq1
\]

\end_inset

und somit auch
\begin_inset Formula 
\[
0=0\cdot0\leq\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\leq1\cdot1=1
\]

\end_inset

oder,
 verkürzt geschrieben
\begin_inset Formula 
\[
0\leq\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\leq1
\]

\end_inset

Ich drehe die Ungleichung um und erhalte:
\begin_inset Formula 
\[
1\geq\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\geq0
\]

\end_inset

also insbesondere
\begin_inset Formula 
\[
\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\geq0
\]

\end_inset

Diese Ungleichung kann ich in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:61"
nolink "false"

\end_inset

 einfügen und erhalte:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\vee B\right)\\
 & = & \delta\left(A\right)+\left(1-\delta\left(A\right)\right)\cdot\delta\left(B\right)\\
 & \geq & \delta\left(A\right)+0\\
 & = & \delta\left(A\right)
\end{eqnarray*}

\end_inset

Auch diese sogenannte Abschätzung kann ich verkürzt umschreiben zu
\begin_inset Formula 
\[
\delta\left(A\vee B\right)\geq\delta\left(A\right)
\]

\end_inset

Ich kann diese sogenannte Ungleichung umdrehen zu
\begin_inset Formula 
\[
\delta\left(A\right)\leq\delta\left(A\vee B\right)
\]

\end_inset

Das Lemma 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Implikation-kleiner-gleich"
nolink "false"

\end_inset

 besagt nun,
 dass ich daraus schließen kann,
 dass gilt:
\begin_inset Formula 
\[
A\Rightarrow A\vee B
\]

\end_inset

Somit hätte ich mit einem geradezu gigantischem Aufwand gezeigt,
 der Beweis der Behauptung erbracht ist.
 Nun möchte ich den Beweis auf eine weniger elegante Art ebenfalls erbringen:
\end_layout

\begin_layout Proof
Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Implikation"
nolink "false"

\end_inset

 kann ich schreiben:
\begin_inset Formula 
\begin{eqnarray}
\delta\left(A\Rightarrow\left(A\vee B\right)\right) & = & 1-\delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right)\label{eq:62}
\end{eqnarray}

\end_inset

Aufgrund des Distributivgesetzes der Multiplikation und der Addition von ganzen Zahlen kann ich schreiben:
\begin_inset Formula 
\begin{equation}
\delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right)=\delta\left(A\right)-\delta\left(A\right)\cdot\delta\left(A\vee B\right)\label{eq:63}
\end{equation}

\end_inset


\end_layout

\begin_layout Proof
Wenn ich zeigen kann,
 dass gilt:
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right)=0
\]

\end_inset

dann bin ich am Ziel.
 Denn in diesem Fall muss gelten
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\Rightarrow\left(A\vee B\right)\right)\\
 & = & 1-\delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right)\\
 & = & 1-0\\
 & = & 1
\end{eqnarray*}

\end_inset

Also möchte ich im Folgenden zeigen,
 dass
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right)=0
\]

\end_inset

ist.
 Ich multipliziere den Ausdruck
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right)
\]

\end_inset

aus und erhalte
\begin_inset Formula 
\begin{eqnarray}
\delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right) & = & \delta\left(A\right)-\delta\left(A\right)\cdot\delta\left(A\vee B\right)\label{eq:64}
\end{eqnarray}

\end_inset

Aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Implikation"
nolink "false"

\end_inset

 der Deltanotation der Implikation kann ich schreiben:
\begin_inset Formula 
\[
\delta\left(A\vee B\right)=\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)
\]

\end_inset

Nun kann ich diese Gleichung auf beiden Seiten mit 
\begin_inset Formula $\delta\left(A\right)$
\end_inset

 multiplizieren und erhalte
\begin_inset Formula 
\begin{eqnarray}
\delta\left(A\right)\cdot\delta\left(A\vee B\right) & = & \delta\left(A\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\label{eq:65}
\end{eqnarray}

\end_inset

Den Ausdruck 
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)
\]

\end_inset

kann ich aufgrund des Distributivgesetzes der Multiplikation umrechnen zu
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & \delta\left(A\right)\cdot\delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & \delta^{2}\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-\delta^{2}\left(A\right)\cdot\delta\left(B\right)
\end{eqnarray*}

\end_inset

Da die Gleichheit von ganzen Zahlen transitiv ist,
 kann ich die obige Kette von Gleichungen verkürzt aufschreiben zu 
\begin_inset Formula 
\begin{equation}
\delta\left(A\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)=\delta^{2}\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-\delta^{2}\left(A\right)\cdot\delta\left(B\right)\label{eq:66}
\end{equation}

\end_inset

Die Deltanotation von Aussagen ist gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Idempotenz"
nolink "false"

\end_inset

 idempotent.
 Darum kann ich die vorhergehende Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:65"
nolink "false"

\end_inset

 umschreiben zu
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & \delta^{2}\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-\delta^{2}\left(A\right)\cdot\delta\left(B\right)\\
 & = & \delta\left(A\right)+\delta\left(A\right)\cdot\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & \delta\left(A\right)+0\\
 & = & \delta\left(A\right)
\end{eqnarray*}

\end_inset

Wiederum aufgrund der Transitivität der Gleichheit von ganzen Zahlen kann ich dies Kette von Gleichungen verkürzt aufschreiben zu
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)=\delta\left(A\right)
\]

\end_inset

Setze ich diese Gleichung in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:65"
nolink "false"

\end_inset

 ein,
 dann erhalte ich
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\right)\cdot\delta\left(A\vee B\right)\\
 & = & \delta\left(A\right)\cdot fv\left(\delta\left(A\right)+\delta\left(B\right)-\delta\left(A\right)\cdot\delta\left(B\right)\right)\\
 & = & \delta\left(A\right)
\end{eqnarray*}

\end_inset

und wiederum aufgrund der Transitivität der Gleichheit von ganzen Zahlen verkürzt aufgeschrieben:
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\delta\left(A\vee B\right)=\delta\left(A\right)
\]

\end_inset

Wenn ich diese Gleichheit in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:63"
nolink "false"

\end_inset

 einsetze dann erhalte ich:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right)\\
 & = & \delta\left(A\right)-\delta\left(A\right)\cdot\delta\left(A\vee B\right)\\
 & = & \delta\left(A\right)-\delta\left(A\right)\\
 & = & 0
\end{eqnarray*}

\end_inset

oder wiederum aufgrund der Transitivität der Gleichheit von ganzen Zahlen umgeschrieben:
\begin_inset Formula 
\begin{eqnarray*}
\delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right) & = & 0
\end{eqnarray*}

\end_inset

Dieses Resultat kann ich dann in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:62"
nolink "false"

\end_inset

 einsetzen und erhalte dann,
 wie gewünscht:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\Rightarrow\left(A\vee B\right)\right)\\
 & = & 1-\delta\left(A\right)\cdot\left(1-\delta\left(A\vee B\right)\right)\\
 & = & 1-0\\
 & = & 1
\end{eqnarray*}

\end_inset

also erneut aufgrund der Transitivität der Gleichheit der ganzen Zahlen
\begin_inset Formula 
\[
\delta\left(A\Rightarrow\left(A\vee B\right)\right)=1
\]

\end_inset


\end_layout

\begin_layout Proof
Also kann ich gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Eindeutigkeitssatz"
nolink "false"

\end_inset

 folgern,
 dass die Aussage 
\begin_inset Formula $A\Rightarrow\left(A\vee B\right)$
\end_inset

 für alle Aussagen 
\begin_inset Formula $A$
\end_inset

 oder 
\begin_inset Formula $B$
\end_inset

 wahr sein muss und darum ein logischer Satz sein muss.
 Darum wage ich an dieser Stelle die Behauptung,
 den Beweis für die Richtigkeit des Satzes erneut erbracht zu haben.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Satz der Äquivalenz von Äquivalenz und negierten Aussagen 
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Es seien 
\begin_inset Formula $A,B$
\end_inset

 Metasymbole von Aussagen,
 welche in sich selbst und bezüglich den Aussagen des Satzes widerspruchsfrei seien.
 Dann gilt
\begin_inset Formula 
\[
\left(A\Leftrightarrow B\right)\Leftrightarrow\left(\neg A\Leftrightarrow\neg B\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Antivalenz"
nolink "false"

\end_inset

 der Deltanotation der Äquivalenz gilt 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\left(A\Leftrightarrow B\right)\Leftrightarrow\left(\neg A\Leftrightarrow\neg B\right)\right)\\
 & = & 1-\left(\delta\left(A\Leftrightarrow B\right)-\delta\left(\neg A\Leftrightarrow\neg B\right)\right)^{2}
\end{eqnarray*}

\end_inset

Wenn ich also zeigen kann,
 dass gilt
\begin_inset Formula 
\[
\delta\left(A\Leftrightarrow B\right)=\delta\left(\neg A\Leftrightarrow\neg B\right)
\]

\end_inset

dann bin ich am Ziel.
 Es gilt wiederum gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Antivalenz"
nolink "false"

\end_inset

 der Deltanotation der Äquivalenz gilt 
\begin_inset Formula 
\begin{eqnarray}
\delta\left(\neg A\Leftrightarrow\neg B\right) & = & 1-\left(\delta\left(\neg A\right)-\delta\left(\neg B\right)\right)^{2}\label{eq:67}
\end{eqnarray}

\end_inset

Nun möchte ich zeigen,
 dass gilt:
\begin_inset Formula 
\[
\delta\left(\neg A\right)-\delta\left(\neg B\right)=\delta\left(B\right)-\delta\left(A\right)
\]

\end_inset

Es gilt aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 
\begin_inset Formula 
\begin{eqnarray*}
\delta\left(\neg A\right) & = & 1-\delta\left(A\right)\\
\delta\left(\neg B\right) & = & 1-\delta\left(B\right)
\end{eqnarray*}

\end_inset

und somit
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\neg A\right)-\delta\left(\neg B\right)\\
 & = & 1-\delta\left(A\right)-\left(1-\delta\left(B\right)\right)
\end{eqnarray*}

\end_inset

Die Klammer um den Ausdruck 
\begin_inset Formula $1-\delta\left(B\right)$
\end_inset

 kann ich wegen den Rechenregeln der ganzen Zahlen auflösen zu 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\neg A\right)-\delta\left(\neg B\right)\\
 & = & 1-\delta\left(A\right)-\left(1-\delta\left(B\right)\right)\\
 & = & 1-\delta\left(A\right)-1+\delta\left(B\right)\\
 & = & 1-1+\delta\left(B\right)-\delta\left(A\right)\\
 & = & 0+\delta\left(B\right)-\delta\left(A\right)\\
 & = & \delta\left(B\right)-\delta\left(A\right)
\end{eqnarray*}

\end_inset

Auch diese Kette von Gleichungen kann wegen der Transitivität der Gleichheit von ganzen Zahlen verkürzt werden zu:
\begin_inset Formula 
\begin{equation}
\delta\left(\neg A\right)-\delta\left(\neg B\right)=\delta\left(B\right)-\delta\left(A\right)\label{eq:68}
\end{equation}

\end_inset

Nun kann ich schreiben,
 indem ich die Rechenregeln der ganzen Zahlen anwende:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\\
 & = & \left(-\left(-\delta\left(A\right)+\delta\left(B\right)\right)\right)^{2}\\
 & = & \left(-\left(\delta\left(B\right)-\delta\left(A\right)\right)\right)^{2}\\
 & = & \left(-1\cdot\left(\delta\left(B\right)-\delta\left(A\right)\right)\right)^{2}\\
 & = & \left(-1\right)^{2}\cdot\left(\delta\left(B\right)-\delta\left(A\right)\right)^{2}\\
 & = & 1\cdot\left(\delta\left(B\right)-\delta\left(A\right)\right)^{2}\\
 & = & \left(\delta\left(B\right)-\delta\left(A\right)\right)^{2}
\end{eqnarray*}

\end_inset

Da die Gleichheit von ganzen Zahlen transitiv ist,
 kann ich verkürzt schreiben
\begin_inset Formula 
\[
\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}=\left(\delta\left(B\right)-\delta\left(A\right)\right)^{2}
\]

\end_inset

Nun kann ich die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:68"
nolink "false"

\end_inset

 verwenden und schreiben:
 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\\
 & = & \left(\delta\left(B\right)-\delta\left(A\right)\right)^{2}\\
 & = & \left(\delta\left(\neg A\right)-\delta\left(\neg B\right)\right)^{2}
\end{eqnarray*}

\end_inset

Aufgrund der Transitivität der Gleichheit von ganzen Zahlen kann ich also schreiben:
\begin_inset Formula 
\[
\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}=\left(\delta\left(\neg A\right)-\delta\left(\neg B\right)\right)^{2}
\]

\end_inset

Da die Gleichheit symmetrisch ist,
 kann ich auch schreiben
\begin_inset Formula 
\begin{eqnarray*}
 &  & \left(\delta\left(\neg A\right)-\delta\left(\neg B\right)\right)^{2}\\
 & = & \left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}
\end{eqnarray*}

\end_inset

Wenn ich dieses Resultat in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:67"
nolink "false"

\end_inset

 einfüge,
 dann erhalte ich
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\neg A\Leftrightarrow\neg B\right)\\
 & = & 1-\left(\delta\left(\neg A\right)-\delta\left(\neg B\right)\right)^{2}\\
 & = & 1-\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}
\end{eqnarray*}

\end_inset

Wiederum aufgrund der Transitivität der Gleichheit von ganzen Zahlen kann ich schreiben:
\begin_inset Formula 
\[
\delta\left(\neg A\Leftrightarrow\neg B\right)=1-\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}
\]

\end_inset

Nun kann ich den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Aequivalenz"
nolink "false"

\end_inset

 sozusagen umgekehrt verwenden und erhalte
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(\neg A\Leftrightarrow\neg B\right)\\
 & = & 1-\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\\
 & = & \delta\left(A\Leftrightarrow B\right)
\end{eqnarray*}

\end_inset

Und wenn ich die Transitivität erneut anwende,
 erhalte ich
\begin_inset Formula 
\[
\delta\left(\neg A\Leftrightarrow\neg B\right)=\delta\left(A\Leftrightarrow B\right)
\]

\end_inset

Schlussendlich kann ich ebenfalls den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Aequivalenzsatz"
nolink "false"

\end_inset

 ebenfalls 
\begin_inset Quotes gld
\end_inset

umgekehrt
\begin_inset Quotes grd
\end_inset

 anwenden und erhalte:
\begin_inset Formula 
\[
\left(\neg A\Leftrightarrow\neg B\right)\Leftrightarrow\left(A\Leftrightarrow B\right)
\]

\end_inset

Das war jedoch genau die Behauptung.
 Somit glaube ich,
 die Richtigkeit der Behauptung wiederum gezeigt zu haben.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Äquivalenz-Antivalenz-Satz
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Es seien 
\begin_inset Formula $A,B$
\end_inset

 Metasymbole von Aussagen,
 welche in sich selbst und in Bezug auf die anderen Symbolen des Satzes widerspruchsfrei seien.
 Dann gilt:
\begin_inset Formula 
\[
\neg\left(A\Leftrightarrow B\right)\Leftrightarrow\left(A\nLeftrightarrow B\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Ich möchte zuerst zeigen,
 dass gilt
\begin_inset Formula 
\begin{equation}
\delta\left(\neg\left(A\Leftrightarrow B\right)\right)=\delta\left(A\nLeftrightarrow B\right)\label{eq:69}
\end{equation}

\end_inset

Aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Konjunktion"
nolink "false"

\end_inset

 der Deltanotation der Negation kann ich schreiben:
\begin_inset Formula 
\begin{equation}
\delta\left(\neg\left(A\Leftrightarrow B\right)\right)=1-\delta\left(A\Leftrightarrow B\right)\label{eq:70}
\end{equation}

\end_inset

Nun kann ich aufgrund des Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Aequivalenz"
nolink "false"

\end_inset

 schreiben:
\begin_inset Formula 
\[
\delta\left(A\Leftrightarrow B\right)=1-\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}
\]

\end_inset

Diese Gleichung kann ich in die vorhergehende Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:70"
nolink "false"

\end_inset

 einsetzen und erhalte:
\begin_inset Formula 
\begin{align*}
 & \delta\left(\neg\left(A\Leftrightarrow B\right)\right)\\
= & 1-\delta\left(A\Leftrightarrow B\right)\\
= & 1-\left(1-\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\right)
\end{align*}

\end_inset

oder,
 da die Gleichheit von ganzen Zahlen transitiv ist:
\begin_inset Formula 
\[
\delta\left(\neg\left(A\Leftrightarrow B\right)\right)=1-\left(1-\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\right)
\]

\end_inset

Aufgrund der Rechenregeln für ganze Zahlen kann ich diese Gleichung umformen zu
\begin_inset Formula 
\begin{align*}
 & \delta\left(\neg\left(A\Leftrightarrow B\right)\right)\\
= & 1-\left(1-\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\right)\\
= & 1-1+\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\\
= & 0+\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\\
= & \left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}
\end{align*}

\end_inset

oder wiederum aufgrund der Transitivität der Gleichheit von ganzen Zahlen verkürzt aufgeschrieben:
\begin_inset Formula 
\begin{align}
\delta\left(\neg\left(A\Leftrightarrow B\right)\right)= & \left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}\label{eq:71}
\end{align}

\end_inset

Der Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Antivalenz"
nolink "false"

\end_inset

 
\begin_inset Quotes gld
\end_inset

rückwärts angewendet
\begin_inset Quotes grd
\end_inset

 besagt nun,
 dass gilt
\begin_inset Formula 
\[
\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}=\delta\left(A\nLeftrightarrow B\right)
\]

\end_inset

Dieses Resultat kann ich nun ich die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:71"
nolink "false"

\end_inset

 einfügen und erhalte dadurch
\begin_inset Formula 
\[
\delta\left(\neg\left(A\Leftrightarrow B\right)\right)=\left(\delta\left(A\right)-\delta\left(B\right)\right)^{2}=\delta\left(A\nLeftrightarrow B\right)
\]

\end_inset

oder wiederum dank der Transitivität der Gleichheit von ganzen Zahlen verkürzt aufgeschrieben:
\begin_inset Formula 
\[
\delta\left(\neg\left(A\Leftrightarrow B\right)\right)=\delta\left(A\nLeftrightarrow B\right)
\]

\end_inset

Damit habe ich jedoch die Richtigkeit der Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:69"
nolink "false"

\end_inset

 erbracht.
 
\end_layout

\begin_layout Proof
Also gilt gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Eindeutigkeitssatz"
nolink "false"

\end_inset

,
 dass die Aussage
\begin_inset Formula 
\[
\left(A\nLeftrightarrow B\right)\Leftrightarrow\neg\left(A\Leftrightarrow B\right)
\]

\end_inset

für alle vernünftigen Aussagen 
\begin_inset Formula $A,B$
\end_inset

 wahr und somit ein logischer Satz ist.
 Darum erachte ich den Satz als erbracht.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Kommutativität der NAND-Verknüpfung
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Es seinen 
\begin_inset Formula $A,B$
\end_inset

 Metasymbole von Aussagen,
 welche in sich selbst,
 jedoch auch in Bezug auf die anderen Aussagen des Beweises widerspruchsfrei seien.
 Dann gilt:
\begin_inset Formula 
\[
A\overline{\wedge}B\Leftrightarrow B\overline{\wedge}A
\]

\end_inset


\end_layout

\begin_layout Proof
Gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-NAND-Verknuepfung"
nolink "false"

\end_inset

 der Delta-Notation der NAND-Verknüpfung kann ich schreiben:Es gilt
\begin_inset Formula 
\begin{eqnarray}
\delta\left(A\overline{\wedge}B\right) & = & 1-\delta\left(A\right)\cdot\delta\left(B\right)\label{eq:72}
\end{eqnarray}

\end_inset

Die Multiplikation von ganzen Zahlen ist kommutativ.
 Darum kann ich schreiben:
\begin_inset Formula 
\[
\delta\left(A\right)\cdot\delta\left(B\right)=\delta\left(B\right)\cdot\delta\left(A\right)
\]

\end_inset

Diese Gleichung kann ich in die vorhergehende Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:72"
nolink "false"

\end_inset

 einsetzen und ich erhalte:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\overline{\wedge}B\right)\\
 & = & 1-\delta\left(A\right)\cdot\delta\left(B\right)\\
 & = & 1-\delta\left(B\right)\cdot\delta\left(A\right)
\end{eqnarray*}

\end_inset

Da die Gleichheit von ganzen Zahlen transitiv ist,
 kann ich die vorhergehende Gleichung verkürzt aufschreiben zu:
\begin_inset Formula 
\begin{eqnarray}
\delta\left(A\overline{\wedge}B\right) & = & 1-\delta\left(B\right)\cdot\delta\left(A\right)\label{eq:73}
\end{eqnarray}

\end_inset

Nun wende ich auf die rechte Seite der Gleichung den Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-NAND-Verknuepfung"
nolink "false"

\end_inset

 rückwärts an und erhalte:
\begin_inset Formula 
\begin{eqnarray*}
1-\delta\left(B\right)\cdot\delta\left(A\right) & = & \delta\left(B\bar{\wedge A}\right)
\end{eqnarray*}

\end_inset

Dieses Resultat setze ich wiederum in die vorhergehende Gleichung ein und erhalte:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\overline{\wedge}B\right)\\
 & = & 1-\delta\left(B\right)\cdot\delta\left(A\right)\\
 & = & \delta\left(B\overline{\wedge}A\right)
\end{eqnarray*}

\end_inset

Wiederum kann ich das Resultat verkürzt aufschreiben,
 da die Gleichheit von ganzen Zahlen transitiv ist und erhalte:
\begin_inset Formula 
\[
\delta\left(A\overline{\wedge}B\right)=\delta\left(B\overline{\wedge}A\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Somit muss gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Aequivalenzsatz"
nolink "false"

\end_inset

 gelten,
 dass 
\begin_inset Formula 
\[
A\overline{\wedge}B\Leftrightarrow B\overline{\wedge}A
\]

\end_inset

ein logischer Satz ist.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Section
Zusammenhang NAND-Verknüpfung und Negation 
\end_layout

\begin_layout Standard
Zu Deiner Erinnerung:
 Es sei 
\begin_inset Formula $A$
\end_inset

 das Metasymbol einer Aussage,
 welche in sich selbst und bezüglich den anderen Symbolen des Satzes widerspruchsfrei sei.
 Dann gilt gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:Zusammenhang-Negation-NAND"
nolink "false"

\end_inset

:
 
\begin_inset Formula 
\[
\left(A\overline{\wedge}A\right)\Leftrightarrow\neg A
\]

\end_inset


\end_layout

\begin_layout Proof
Es gilt gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-NAND-Verknuepfung"
nolink "false"

\end_inset

 der Deltanotation der Negation:
 
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\overline{\wedge}A\right)\\
 & = & 1-\delta\left(A\right)\cdot\delta\left(A\right)\\
 & = & 1-\delta^{2}\left(A\right)
\end{eqnarray*}

\end_inset

und da die Gleichheit von ganzen Zahlen idempotent ist,
 kann ich dies verkürzt aufschreiben zu
\begin_inset Formula 
\begin{equation}
\delta\left(A\overline{\wedge}A\right)=1-\delta^{2}\left(A\right)\label{eq:74}
\end{equation}

\end_inset

Der Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Idempotenz"
nolink "false"

\end_inset

 der Idempotenz der Deltanotation besagt nun,
 dass 
\begin_inset Formula 
\[
\delta^{2}\left(A\right)=\delta\left(A\right)
\]

\end_inset

ist.
 Dieses Resultat kann ich in die vorhergehende Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:74"
nolink "false"

\end_inset

 einsetzen und erhalte:
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\overline{\wedge}A\right)\\
 & = & 1-\delta^{2}\left(A\right)\\
 & = & 1-\delta\left(A\right)
\end{eqnarray*}

\end_inset

Und erneut kann ich dank der Transitivität der Gleichheit von ganzen Zahlen diese Gleichungen verkürzt aufschreiben zu
\begin_inset Formula 
\begin{equation}
\delta\left(A\overline{\wedge}A\right)=1-\delta\left(A\right)\label{eq:75}
\end{equation}

\end_inset

Schlussendlich lehrt mich der Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Negation"
nolink "false"

\end_inset

 der Deltanotation der Negation,
 wenn ich ihn 
\begin_inset Quotes gld
\end_inset

umgekehrt verwende
\begin_inset Quotes grd
\end_inset

,
 dass gelten muss
\begin_inset Formula 
\[
1-\delta\left(A\right)=\delta\left(\neg A\right)
\]

\end_inset

Und auch dieses Resultat kann ich in die Gleichung 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:75"
nolink "false"

\end_inset

 einsetzen und erhalte
\begin_inset Formula 
\begin{eqnarray*}
 &  & \delta\left(A\overline{\wedge}A\right)\\
 & = & 1-\delta\left(A\right)\\
 & = & \delta\left(\neg A\right)
\end{eqnarray*}

\end_inset

Und auch diese Kette von Gleichungen kann ich dank der Transitivität der Gleichheit von ganzen Zahlen verkürzt aufschreiben zu
\begin_inset Formula 
\[
\delta\left(A\overline{\wedge}A\right)=\delta\left(\neg A\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Somit kann gemäß dem Satz 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:delta-Notation-Aequivalenzsatz"
nolink "false"

\end_inset

 schließen,
 dass die Aussage
\begin_inset Formula 
\[
\left(A\overline{\wedge}A\right)\Leftrightarrow\neg A
\]

\end_inset

für alle möglichen Aussagen 
\begin_inset Formula $A$
\end_inset

 wahr und somit ein logischer Satz ist.
 Darum betrachte ich den Beweis des Satzes als erbracht.
\end_layout

