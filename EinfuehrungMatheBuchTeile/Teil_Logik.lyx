\begin{array}{c}
\neg\left(\forall A,B\in\Omega:\phantom{\neg}\left.\left(A\Rightarrow B\right)\Rightarrow\left(\neg A\Rightarrow\neg B\right)\right.\right)\\
\neg\left(\forall A,B\in\Omega:\neg\left(\left(A\Rightarrow B\right)\Rightarrow\left(\neg A\Rightarrow\neg B\right)\right)\right)
\end{array}
\]

\end_inset


