\end_inset

 sowie 
\begin_inset CommandInset ref
LatexCommand ref
reference "tab:2.-Teil-1.-Beweis-1.-erweiterter-Substitutionssatz-Disjunktion"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

,
 andererseits in den Tabellen 
\begin_inset CommandInset ref
