name "prop:4.-Substitutionssatz-Implikation"

\end_inset

Es seien 
\begin_inset Formula $A,B$
\end_inset

 sowie 
\begin_inset Formula $C$
\end_inset

 Aussagen,
 welche in sich selbst und in Bezug auf die anderen Aussagen des Satzes widerspruchsfrei seien.
 Dann gilt die Aussage:
\begin_inset Formula 
\[
\left(A\Rightarrow B\right)\wedge\left(B\Leftrightarrow C\right)\Rightarrow\left(A\Rightarrow C\right)
\]

\end_inset


\end_layout

\begin_layout Proof
Na ja,
 es ist klar,
 dass dieser Satz gilt.
 Die Frage ist bloß,
 warum?
 Angenommen,
 der Satz gelte nicht.
 Dann müsste es Aussagen,
 welche mit den Buchstaben 
\begin_inset Formula $A,B$
\end_inset

 sowie 
\begin_inset Formula $C$
\end_inset

 bezeichnet werden,
 derart geben,
 dass die Behauptung nicht stimmt.
 Dies wäre jedoch gemäß der dritten Zeile der Definition 
\begin_inset CommandInset ref
LatexCommand ref
reference "def:Implikation"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 der Implikation nur dann möglich,
 falls die Aussage 
\begin_inset Formula 
\[
A\Rightarrow C
\]

\end_inset

nicht wahr wäre,
 die Aussage 
\begin_inset Formula 
\[
\left(A\Rightarrow B\right)\wedge\left(B\Leftrightarrow C\right)
\]

\end_inset

jedoch wahr wäre.
 Die Aussage 
\begin_inset Formula 
\[
A\Rightarrow C
\]

\end_inset

ist gemäß der gleichen Zeile der Definition 
\begin_inset CommandInset ref
LatexCommand ref
reference "def:Implikation"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 der Implikation dann nicht wahr,
 falls die Aussage 
\begin_inset Formula $A$
\end_inset

 wahr ist,
 die Aussage 
\begin_inset Formula $C$
\end_inset

 jedoch nicht wahr ist.
 Die Aussage 
\end_layout

\begin_layout Proof
\begin_inset Formula 
\[
\left(A\Rightarrow B\right)\wedge\left(B\Leftrightarrow C\right)
\]

\end_inset

ist gemäß der vierten Zeile der Definition 
\begin_inset CommandInset ref
LatexCommand ref
reference "def:Konjunktion"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 der Konjunktion dann wahr,
 falls sowohl die Aussage 
\begin_inset Formula 
\[
A\Rightarrow B
\]

\end_inset

wie auch die Aussage 
\begin_inset Formula 
\[
B\Leftrightarrow C
\]

\end_inset

wahr sind.
 Da die Aussage 
\begin_inset Formula 
\[
A\Rightarrow B
\]

\end_inset

wahr sein soll,
 müsste die Aussage 
\begin_inset Formula $B$
\end_inset

 wahr sein.
 Denn wie ich oben zu zeigen versucht habe,
 müsste die Aussage 
\begin_inset Formula $A$
\end_inset

 wahr sein,
 falls die gesamte Aussage nicht war wäre.
 Wäre dann die Aussage 
\begin_inset Formula $B$
\end_inset

 nicht wahr,
 dann wäre die Aussage gemäß der dritten Zeile der Definition 
\begin_inset CommandInset ref
LatexCommand ref
reference "def:Implikation"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 der Implikation die Aussage 
\begin_inset Formula 
\[
A\Rightarrow B
\]

\end_inset

nicht wahr - im Widerspruch zur Voraussetzung.
 Wäre jedoch die Aussage 
\begin_inset Formula $B$
\end_inset

 wahr,
 dann wäre gemäß der vierten Zeile der Definition 
\begin_inset CommandInset ref
LatexCommand ref
reference "def:Implikation"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 der Implikation die Aussage 
\begin_inset Formula 
\[
A\Rightarrow B
\]

\end_inset

wahr.
 Dann wäre jedoch gemäß der dritten Zeile der Definition 
\begin_inset CommandInset ref
LatexCommand ref
reference "def:Aequivalenz"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 der Äquivalenz die Aussage
\begin_inset Formula 
\[
B\Leftrightarrow C
\]

\end_inset

nicht wahr.
 Denn die Aussage 
\begin_inset Formula $B$
\end_inset

 muss gemäß der Aussage
\begin_inset Formula 
\[
A\Rightarrow B
\]

\end_inset

wahr sein.
 Die Aussage 
\begin_inset Formula $C$
\end_inset

 kann gemäß der Aussage
\begin_inset Formula 
\[
A\Rightarrow C
\]

\end_inset

nicht wahr sein.
 Dies ist jedoch ein Widerspruch zur Voraussetzung,
 dass die Aussage 
\begin_inset Formula 
\[
B\Leftrightarrow C
\]

\end_inset

 trotzdem wahr sein muss.
 Darum glaube ich gezeigt zu haben,
 dass es keine Aussagen mit den Bezeichnungen 
\begin_inset Formula $A,\,B$
\end_inset

 sowie 
\begin_inset Formula $C$
\end_inset

 derart geben kann dass die Aussage
\begin_inset Formula 
\[
\left(A\Rightarrow B\right)\wedge\left(B\Leftrightarrow C\right)\Rightarrow\left(A\Rightarrow C\right)
\]

\end_inset

nicht wahr ist.
 Also muss aufgrund des abgeschwächten Satzes 
\begin_inset CommandInset ref
LatexCommand ref
reference "prop:ausgeschlossener-Dritter"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 der doppelten Negation die Aussage für alle möglich Aussagen 
\begin_inset Formula $A,B$
\end_inset

 sowie 
\begin_inset Formula $C$
\end_inset

 wahr sein.
\end_layout

\begin_layout Proof
