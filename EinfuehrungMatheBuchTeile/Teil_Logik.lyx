LatexCommand ref
reference "tab:1.-Teil-1.-Beweis-2.-Substitutionssatz-Antivalenz"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 und 
\begin_inset CommandInset ref
LatexCommand ref
reference "tab:2.-Teil-1.-Beweis-2.-Substitutionssatz-Antivalenz"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 sowie 
\begin_inset CommandInset ref
LatexCommand ref
reference "tab:1.-Teil-2.-Beweis-2.-Substitutionssatz-Antivalenz"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 und 
\begin_inset CommandInset ref
LatexCommand ref
reference "tab:2.-Teil-2.-Beweis-2.-Substitutionssatz-Antivalenz"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 abgelegt.
 Die Verweise habe ich in den Tabellen 
